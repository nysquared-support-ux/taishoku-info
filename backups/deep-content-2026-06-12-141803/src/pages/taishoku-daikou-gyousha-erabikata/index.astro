---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行業者の選び方｜5軸の比較と確認チェックリスト（2026年版・PR）';
const description = '退職代行業者を「運営主体・料金・対応範囲・実績・サポート」の5軸で比較する選び方を整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '業者選び方' },
];

const faq = [
  { q: '退職代行業者の「運営主体」で選ぶとはどういうことですか？', a: '運営主体（労働組合、弁護士法人、民間企業）により対応範囲が異なります。例えば弁護士法人は未払い賃金請求等の「法律事務」を伴う交渉が可能です。これは弁護士法第72条で非弁護士の法律事務が禁止されているためです。ご自身の状況に合わせ、適切な運営主体を選ぶことが重要とされます。' },
  { q: '料金が安い業者を選んでも問題ないでしょうか？', a: '料金だけで選ぶと、追加料金が発生したりサポートが不十分だったりする可能性があります。料金体系（一律かオプションか）やサービス内容を契約前に確認することが大切です。国民生活センターも、サービス利用時の契約内容の十分な確認を呼びかけています。総合的なコストで判断することが推奨されます。' },
  { q: '労働組合が運営する退職代行のメリットは何ですか？', a: '労働組合が運営する業者は、労働組合法に基づく団体交渉権を持つため、会社との交渉が可能です。これにより、有給休暇の消化や退職日の調整などを円滑に進められる可能性が高まります。弁護士に依頼するよりも費用を抑えられる傾向にある点もメリットと一般にされます。' },
  { q: '業者選びで失敗しないための注意点はありますか？', a: '実績や口コミを鵜呑みにせず、公式サイトでサービス内容を詳細に確認することが重要です。特に、対応範囲（正社員、アルバイト等）や連絡手段（LINE、電話）、返金保証の有無は事前にチェックすべき項目です。消費者庁も、サービス利用前の契約内容確認の重要性を指摘しています。' },
  { q: '結局、自分に合った退職代行業者はどうやって選べば良いですか？', a: 'まずご自身の状況（交渉事の有無、雇用形態、予算など）を整理しましょう。その上で、「運営主体」「料金」「対応範囲」「実績」「サポート」の5つの軸で複数の業者を比較検討することが、ご自身にとって最適な選択に繋がると考えられます。本記事のチェックリストもご活用ください。' },
];
---

