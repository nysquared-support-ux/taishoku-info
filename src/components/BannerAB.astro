---
/**
 * BannerAB.astro - 退職代行Jobs アクセストレード A/Bテスト対応CTAコンポーネント
 *
 * Round U-2 [kzPklZSdFu] 2026-04-29: TechGo (A8.net・転職特化) → 退職代行Jobs (アクセストレード・退職検討者直接訴求) に置換
 * 理由: ★356 候補「サイト×案件×ターゲット 3 軸マトリクス」適用
 *   - taishoku-info LP: 退職検討者向け → 退職代行Jobs (CVR 9.95%/EPC ¥736.47/承認率 93.33%) が最適
 *   - TechGo は tenshoku-compare-info (転職比較ガイド) で展開予定
 *
 * 4条件ランダム表示:
 *  A (25%): テキストリンク (素材1215838 - 「サービス料金 24,000 円」価格訴求)
 *  B (25%): バナー 300×250 (素材1215856 - 退職代行Jobs ロゴ大)
 *  C (25%): バナー 250×250 (素材1215855 - 退職代行Jobs ロゴ正方形)
 *  D (25%): バナー 120×60 (素材1215854) + テキスト 1216763 のスクロール連動フローティング
 *
 * localStorage で訪問者単位の決定固定（再訪でも同じバリアント）
 * page_slug プロパティで記事別識別子を生成
 *
 * 案件: 退職代行Jobs (株式会社アレス・アクセストレード ID 1146802)
 * 報酬: ¥12,000 / 新規入会 (定額報酬)
 * リンクコード形式: https://h.accesstrade.net/sp/cc?rk=...
 *
 * 重要: リスティング条件あり (Google 広告で「退職代行Jobs」キーワード直接ターゲティング NG)
 *      自社 LP オーガニック流入 / 一般キーワード「退職代行」「退職」/ TikTok 等は OK
 */
interface Props {
  pageSlug?: string;  // 記事別識別子 (例: 'lp-a', 'damage-risk')
  position?: 'hero' | 'middle' | 'footer' | 'sticky';
  label?: string;  // 明示指定する場合の文言（未指定なら 10 パターン自動ローテーション）
  ctaRotate?: boolean;  // 10 パターンABローテーション有効化（default: true）
}
const {
  pageSlug = 'unknown',
  position = 'middle',
  label,
  ctaRotate = true,
} = Astro.props;

// CTA 10パターン（退職代行Jobs 訴求・★354 教訓反映の中立表現）
// 設計方針: 法務セーフ + 価格訴求 + 行動明示 の 3 軸ブレンド
// ★354 反映: 「3 日で退職完了」等の数値保証 NG・「全部代行」等の弁護士法非弁誤認 NG
const CTA_PATTERNS = [
  '退職代行Jobs サービス料金 24,000 円 (PR)',                        // 0: 価格訴求 (コントロール)
  '退職代行を相談する - 退職代行Jobs 公式サイト (PR)',                  // 1: 直接行動
  '退職検討中の方へ - 退職代行Jobs (PR)',                            // 2: ターゲット明示
  '退職代行サービスの詳細を見る (PR)',                               // 3: 中立情報誘導
  '24,000 円の退職代行サービスを確認 (PR)',                          // 4: 価格 + 行動
  '退職代行Jobs の対応範囲を確認 (PR)',                              // 5: 対応範囲訴求
  '退職代行 公式サイト - 詳細を確認 (PR)',                           // 6: 公式訴求
  '相談から退職まで - 退職代行Jobs (PR)',                            // 7: フロー訴求
  '退職をプロに依頼する - 退職代行Jobs (PR)',                        // 8: 専門家訴求
  '退職代行Jobs を検討する (PR・個別事情により異なります)',             // 9: 慎重訴求
];

const defaultLabel = label || CTA_PATTERNS[0];
---

<div class="banner-ab-root my-6" data-page-slug={pageSlug} data-position={position} data-label={defaultLabel} data-cta-rotate={ctaRotate ? '1' : '0'}>
  <!-- デフォルト表示（JS実行前/JS無効/JSエラー時のフォールバック） -->
  <div class="banner-ab-slot">
    <a href="https://h.accesstrade.net/sp/cc?rk=0100q25a00ormk"
       target="_blank" rel="noopener nofollow sponsored"
       class="block text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded transition"
       data-variant="fallback" data-material="txt_1215838">
      {defaultLabel}
    </a>
    <img border="0" width="1" height="1"
         src="https://h.accesstrade.net/sp/rr?rk=0100q25a00ormk"
         alt="" loading="lazy" style="position:absolute;left:-9999px" />
  </div>
  <p class="text-xs text-gray-700 mt-2 text-center">
    PR / 退職代行Jobs (株式会社アレス) 公式サイトへ遷移 / アフィリエイト広告 / 個別事情により結果は異なります
  </p>
</div>

<script define:vars={{ pageSlug, position, defaultLabel, ctaRotate, CTA_PATTERNS }}>
  (function() {
    const root = document.querySelector(`.banner-ab-root[data-page-slug="${pageSlug}"][data-position="${position}"]`);
    if (!root) return;
    const slot = root.querySelector('.banner-ab-slot');
    if (!slot) return;

    // === URLパラメータによる強制指定（テスト用・★302 検証ツール） ===
    // ?ab=A|B|C|D で variant 強制、?cta=0-9 で CTA 強制
    const urlParams = new URLSearchParams(window.location.search);
    const forcedVariant = urlParams.get('ab');
    const forcedCta = urlParams.get('cta');

    // === バリアント決定 (URL強制 > localStorage固定・4条件均等分散) ===
    let variant;
    if (forcedVariant && ['A', 'B', 'C', 'D'].includes(forcedVariant.toUpperCase())) {
      variant = forcedVariant.toUpperCase();
    } else {
      // ★Round U-2: TechGo→退職代行Jobs 切替で variant_v1 をリセット
      variant = localStorage.getItem('ab_variant_v2_jobs');
      if (!variant || !['A', 'B', 'C', 'D'].includes(variant)) {
        const r = Math.random();
        variant = r < 0.25 ? 'A' : r < 0.50 ? 'B' : r < 0.75 ? 'C' : 'D';
        localStorage.setItem('ab_variant_v2_jobs', variant);
        localStorage.setItem('ab_variant_v2_jobs_set_at', new Date().toISOString());
      }
    }
    root.setAttribute('data-variant', variant);

    // === CTA 10パターン 第二軸決定 ===
    let ctaIdx;
    if (forcedCta !== null && !isNaN(parseInt(forcedCta, 10))) {
      const forced = parseInt(forcedCta, 10);
      if (forced >= 0 && forced < CTA_PATTERNS.length) {
        ctaIdx = forced;
      }
    }
    if (ctaIdx === undefined) {
      ctaIdx = parseInt(localStorage.getItem('ab_cta_v2_jobs') || '-1', 10);
      if (ctaRotate && (isNaN(ctaIdx) || ctaIdx < 0 || ctaIdx >= CTA_PATTERNS.length)) {
        ctaIdx = Math.floor(Math.random() * CTA_PATTERNS.length);
        localStorage.setItem('ab_cta_v2_jobs', String(ctaIdx));
        localStorage.setItem('ab_cta_v2_jobs_set_at', new Date().toISOString());
      }
    }
    const label = (ctaRotate && ctaIdx >= 0) ? CTA_PATTERNS[ctaIdx] : defaultLabel;
    root.setAttribute('data-cta-idx', ctaRotate ? String(ctaIdx) : 'fixed');

    // === バリアント別HTML定義（退職代行Jobs 素材 1215838/1215856/1215855/1215854） ===
    const variants = {
      A: {
        // 素材 1215838: テキストリンク (「サービス料金 24,000 円」価格訴求)
        material: 'txt_1215838_24000yen',
        rk: '0100q25a00ormk',
        html: `
          <a href="https://h.accesstrade.net/sp/cc?rk=0100q25a00ormk"
             target="_blank" rel="noopener nofollow sponsored"
             class="block text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded transition"
             data-variant="A" data-material="txt_1215838">
            ${label}
          </a>
          <img border="0" width="1" height="1"
               src="https://h.accesstrade.net/sp/rr?rk=0100q25a00ormk"
               alt="" loading="lazy" style="position:absolute;left:-9999px" />
        `,
      },
      B: {
        // 素材 1215856: バナー 300×250 (退職代行Jobs ロゴ大)
        material: 'banner_1215856_300x250',
        rk: '0100q25s00ormk',
        html: `
          <div class="text-center">
            <a href="https://h.accesstrade.net/sp/cc?rk=0100q25s00ormk"
               target="_blank" rel="noopener nofollow sponsored"
               data-variant="B" data-material="banner_1215856_300x250">
              <img border="0" width="300" height="250" alt="退職代行Jobs"
                   src="https://h.accesstrade.net/sp/rr?rk=0100q25s00ormk"
                   loading="lazy" style="max-width:100%;height:auto;" />
            </a>
            <a href="https://h.accesstrade.net/sp/cc?rk=0100q2uz00ormk"
               target="_blank" rel="noopener nofollow sponsored"
               class="block mt-2 text-sm text-blue-700 underline"
               data-variant="B-text" data-material="txt_1216763">
              ${label}
            </a>
          </div>
        `,
      },
      C: {
        // 素材 1215855: バナー 250×250 (退職代行Jobs ロゴ正方形)
        material: 'banner_1215855_250x250',
        rk: '0100q25r00ormk',
        html: `
          <div class="text-center">
            <a href="https://h.accesstrade.net/sp/cc?rk=0100q25r00ormk"
               target="_blank" rel="noopener nofollow sponsored"
               data-variant="C" data-material="banner_1215855_250x250">
              <img border="0" width="250" height="250" alt="退職代行Jobs"
                   src="https://h.accesstrade.net/sp/rr?rk=0100q25r00ormk"
                   loading="lazy" style="max-width:100%;height:auto;" />
            </a>
            <a href="https://h.accesstrade.net/sp/cc?rk=0100q2uz00ormk"
               target="_blank" rel="noopener nofollow sponsored"
               class="block mt-2 text-sm text-blue-700 underline"
               data-variant="C-text" data-material="txt_1216763">
              ${label}
            </a>
          </div>
        `,
      },
      D: {
        // 素材 1215856 (300×250) + スクロール連動フローティング (素材 1215854 120×60 を float)
        material: 'banner_1215856_floating',
        rk: '0100q25s00ormk',
        html: `
          <div class="text-center">
            <a href="https://h.accesstrade.net/sp/cc?rk=0100q25s00ormk"
               target="_blank" rel="noopener nofollow sponsored"
               data-variant="D" data-material="banner_1215856_floating">
              <img border="0" width="300" height="250" alt="退職代行Jobs"
                   src="https://h.accesstrade.net/sp/rr?rk=0100q25s00ormk"
                   loading="lazy" style="max-width:100%;height:auto;" />
            </a>
            <a href="https://h.accesstrade.net/sp/cc?rk=0100q2uz00ormk"
               target="_blank" rel="noopener nofollow sponsored"
               class="block mt-2 text-sm text-blue-700 underline"
               data-variant="D-text" data-material="txt_1216763">
              ${label}
            </a>
          </div>
        `,
        // スクロール連動フローティングは 'hero' position 時のみ追加表示
        floatingHtml: position === 'hero' ? `
          <div id="floating-cta-${pageSlug}" class="floating-cta" style="display:none;">
            <a href="https://h.accesstrade.net/sp/cc?rk=0100q25q00ormk"
               target="_blank" rel="noopener nofollow sponsored"
               data-variant="D-float" data-material="banner_1215854_120x60_sticky"
               class="floating-cta-link">
              <span class="floating-cta-text">退職代行Jobs に相談する (PR)</span>
            </a>
          </div>
        ` : '',
      },
    };

    // === HTML 注入 ===
    const chosen = variants[variant];
    slot.innerHTML = chosen.html;

    // === D バリアントのみ: フローティングCTA を body に追加 ===
    if (variant === 'D' && chosen.floatingHtml && position === 'hero') {
      if (!document.getElementById(`floating-cta-${pageSlug}`)) {
        const floatDiv = document.createElement('div');
        floatDiv.innerHTML = chosen.floatingHtml;
        document.body.appendChild(floatDiv.firstElementChild);

        // スクロール 30%-95% でフローティング表示
        const floatEl = document.getElementById(`floating-cta-${pageSlug}`);
        if (floatEl) {
          window.addEventListener('scroll', function() {
            const scrolled = window.scrollY;
            const total = document.documentElement.scrollHeight - window.innerHeight;
            if (total > 0 && scrolled / total > 0.3 && scrolled / total < 0.95) {
              floatEl.style.display = 'block';
            } else {
              floatEl.style.display = 'none';
            }
          }, { passive: true });
        }
      }
    }

    // === GA4 インプレッションイベント送信（Cookie同意済の場合のみ） ===
    if (typeof window.gtag === 'function' && localStorage.getItem('cookie_consent') === 'granted') {
      window.gtag('event', 'ab_test_impression', {
        variant: variant,
        material: chosen.material,
        rk: chosen.rk,
        page_slug: pageSlug,
        position: position,
        cta_idx: ctaRotate ? ctaIdx : -1,
        program_id: '1146802',
        program_name: 'taishoku_jobs',
      });
    }

    // === クリック時イベント送信 ===
    slot.querySelectorAll('a[data-variant]').forEach(function(link) {
      link.addEventListener('click', function() {
        if (typeof window.gtag === 'function' && localStorage.getItem('cookie_consent') === 'granted') {
          window.gtag('event', 'ab_test_click', {
            variant: variant,
            material: chosen.material,
            rk: chosen.rk,
            page_slug: pageSlug,
            position: position,
            cta_idx: ctaRotate ? ctaIdx : -1,
            program_id: '1146802',
            program_name: 'taishoku_jobs',
          });
        }
      });
    });
  })();
</script>

<style is:global>
  .floating-cta {
    position: fixed;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    width: calc(100% - 32px);
    max-width: 420px;
    background: #2563eb;
    border: 2px solid #1e40af;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.35);
    animation: floating-cta-slide 0.3s ease-out;
  }
  .floating-cta-link {
    display: block;
    text-align: center;
    padding: 12px 20px;
    color: #ffffff !important;
    font-weight: bold;
    text-decoration: none;
    font-size: 15px;
  }
  .floating-cta-link:hover {
    background: #1e40af;
    border-radius: 9999px;
  }
  @keyframes floating-cta-slide {
    from { transform: translate(-50%, 100%); opacity: 0; }
    to { transform: translateX(-50%); opacity: 1; }
  }
  @media (max-width: 640px) {
    .floating-cta-link { font-size: 14px; padding: 10px 16px; }
  }
</style>
