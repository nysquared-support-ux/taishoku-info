---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行 主要 6 業者徹底比較 2026 年版｜運営主体別の料金・対応範囲を整理';
const description = '退職代行 6 業者の運営主体・料金・対応範囲を中立的に比較。労働組合運営・弁護士運営の違いと選び方を 2026 年最新情報で整理（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行 比較' },
];

const faq = [
  { q: '退職代行サービスの運営主体によって、法的な権限は違うのですか？', a: 'はい、大きく異なります。弁護士法第72条により、法律事務は原則として弁護士のみが行えるとされています。労働組合は労働組合法に基づく団体交渉権を持ちますが、民間企業は退職の意思を伝える「使者」としての役割に限定されると一般に解釈されています。' },
  { q: '運営主体によって料金相場はどのくらい変わりますか？', a: '公開情報をもとに整理すると、民間企業運営が2〜3万円、労働組合運営が2.5〜3.5万円、弁護士運営が5万円以上が一般的な相場とされます。弁護士は交渉や訴訟対応も可能なため高額になる傾向がありますが、その分、対応範囲が最も広くなります。' },
  { q: '有給消化や未払い賃金の「交渉」ができるのはどのタイプですか？', a: '有給消化や未払い賃金などの「交渉」は、労働組合または弁護士が運営するサービスで対応可能とされます。民間企業による交渉行為は弁護士法に抵触する可能性があるため、対応範囲外です。詳細は当ページの主要6業者比較表をご確認ください。' },
  { q: '退職代行業者を比較する上での注意点はありますか？', a: '弁護士資格を持たない業者が報酬を得る目的で法律事務を行う「非弁行為」に注意が必要です。国民生活センターも、退職代行サービスに関する相談事例を公表し注意を促しています。運営元の法人格や対応範囲を事前に確認することが重要です。' },
  { q: '結局、どの運営主体を選べば良いのでしょうか？', a: 'ご自身の状況に合わせて選ぶことが推奨されます。会社と特にトラブルがなく円満に辞めたい場合は民間企業、有給消化などの交渉を希望する場合は労働組合、損害賠償請求など法的な紛争に発展しそうな場合は弁護士、という選択が一般的です。' },
];
---

<RichLayout title={title} description={description} publishedDate="2026-04-25" breadcrumb={breadcrumb} faq={faq}>
<!-- PERSPECTIVE_LEAD_BOX_START -->
<aside class="perspective-lead" style="background:#f8fafc;border-left:4px solid #0ea5e9;padding:16px 20px;margin:24px 0;border-radius:6px;">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
    <span style="font-size:1.4em;">⚖️</span>
    <strong style="color:#0c4a6e;">この LP の独立価値</strong>
  </div>
  <p style="margin:4px 0;font-size:0.95em;color:#0f172a;"><strong>視点 (Perspective):</strong> 比較・選択</p>
  <p style="margin:4px 0;font-size:0.95em;color:#0f172a;"><strong>独自 angle:</strong> comparison に焦点を当てた 比較・選択 視点の独自解説</p>
  <p style="margin:4px 0;font-size:0.9em;color:#475569;"><strong>他 LP との違い:</strong> 他 LP が一般的に 比較・選択 全体を扱うのに対し、本 LP は comparison に絞り込む</p>
</aside>
<!-- PERSPECTIVE_LEAD_BOX_END -->

  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">退職代行 / 主要 6 業者比較</span>
      <h1 id="fv-h1"><span class="accent">退職代行 主要 6 業者徹底比較 2026 年版</span><br />運営主体別の料金・対応範囲を整理</h1>
      <p class="lede">「会社を辞めたいけれど、自分では言い出せない」「すぐにでも退職したい」とお悩みではありませんか？数多くの業者があり、どこを選べば良いか迷ってしまう方も少なくありません。本記事では、主要な退職代行サービス 6 社を「運営主体」という観点から比較し、料金や対応範囲の違いを中立的な立場で整理しました。</p>
      <ul class="fv-bullets">
        <li>運営主体 3 タイプ（民間／労働組合／弁護士法人）の違い</li>
        <li>業者選びの 5 つの判断軸</li>
        <li>主要 6 業者の料金・対応範囲比較表</li>
        <li>状況別の選び方と公的相談窓口</li>
      </ul>
      <PRBadge pageSlug="comparison" />
      <div class="fv-meta">
        <span><b>公開日</b> 2026-04-25</span><span><b>最終更新</b> 2026-05-18</span>
        <span><b>編集</b> NY-squared 編集部</span><span><b>調査時点</b> 2026-04</span>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2>退職代行とは？ 運営主体 3 タイプの違い</h2>
      <p class="section-lede">退職代行サービスは、依頼者に代わって会社に退職の意思を伝えるサービスです。その運営主体は、主に「民間企業」「労働組合」「弁護士法人」の 3 つに大別され、それぞれ法的に認められている業務範囲が異なります。</p>
      <h3>民間企業が運営する退職代行</h3>
      <p>一般的な株式会社などが運営するサービスです。<br>主な業務は依頼者の「退職の意思を伝える」ことに限定されます。<br>有給休暇の取得や未払い賃金の支払いといった「交渉」を伴う行為は、弁護士法第 72 条（非弁行為）に抵触する可能性があるため、原則として行えません。<br>あくまで「使者」としての役割を担います。</p>
      <h3>労働組合が運営する退職代行</h3>
      <p>労働組合法に基づき設立された労働組合が運営するサービスです。<br>労働組合には、憲法で保障された「団体交渉権」があるため、依頼者は組合員になることで、組合として会社側と退職条件（有給消化、未払い残業代など）について交渉することが可能になります。<br>ただし、交渉がまとまらなかった場合の訴訟代理人となることはできません。</p>
      <h3>弁護士法人が運営する退職代行</h3>
      <p>弁護士または弁護士法人が運営するサービスです。<br>弁護士は法律の専門家として、退職の意思伝達のほか、有給消化や未払い賃金、退職金に関する交渉、さらには損害賠償請求といった法的なトラブルが発生した場合の訴訟対応など、退職に関する法律業務を代理で行うことができるとされています。<br>対応範囲が広い分、料金は他の運営主体に比べて高くなる傾向があるようです（実際の対応範囲は各事務所の公式サイトで要確認）。</p>
      <BannerAB pageSlug="comparison" position="hero" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2>業者選びの 5 つの判断軸</h2>
      <p class="section-lede">退職代行サービスを選ぶ際には、以下の 5 つのポイントを確認することをおすすめします。</p>
      <ol>
        <li><strong>運営主体が公式サイトで明示されているか</strong>：前述の通り、運営主体によって対応できる業務範囲が異なります。公式サイトの会社概要ページなどで、運営元が「株式会社」なのか「労働組合」なのか「弁護士法人」なのかを事前に確認することが推奨されます。自身の状況に合わせて適切な運営主体を選ぶことが重要とされています。</li>
        <li><strong>料金体系が透明か</strong>：提示されている料金にどこまでのサービスが含まれているかを確認しましょう。基本料金のほかに、オプション料金や追加料金が発生するケースもあります。「追加料金一切なし」と明記されているか、料金表が分かりやすいかなどをチェックすることが大切です。</li>
        <li><strong>対応時間 (24時間対応の有無)</strong>：「明日からでも会社に行きたくない」という場合、深夜や早朝でも相談・依頼できる 24 時間対応のサービスが心強いでしょう。ご自身の生活リズムや緊急度に合わせて、相談可能な時間帯を確認しておくことをおすすめします。</li>
        <li><strong>返金保証の条件</strong>：万が一、退職が成立しなかった場合に備えて、返金保証制度の有無とその適用条件を確認しておくと安心です。「どのような場合に返金対象となるのか」を事前に把握しておくことがトラブル回避につながります。</li>
        <li><strong>連絡手段 (LINE / 電話 / メール)</strong>：相談から依頼完了までの連絡手段も重要です。LINE で手軽にやり取りしたい方、電話で直接相談したい方など、希望する連絡方法に対応しているかを確認しましょう。複数の連絡手段が用意されていると、状況に応じて使い分けることができ便利です。</li>
      </ol>
    </div>
  </section>

  <section class="lp-section"><h2>退職代行の運営主体別比較の基礎知識</h2><p>退職代行サービスを比較する上で最も重要なのが「運営主体」の違いを理解することです。<br>運営主体は主に「民間企業」「労働組合」「弁護士法人」の3タイプに分類されます。<br>これらの最大の違いは、法律上認められた業務範囲にあります。<br>民間企業は退職の意思を伝える「使者」としての役割に留まるとされ、会社との交渉は行えません。<br>一方、労働組合は労働組合法に基づく「団体交渉権」を持ち、未払い賃金や有給消化などの交渉が可能です。<br>そして弁護士は、弁護士法に基づき、交渉から訴訟まで、退職に関するあらゆる法律事務を代理できます。<br>ご自身の状況に合わない業者を選ぶと、希望する対応をしてもらえない可能性があるため、この違いを理解することが業者比較の第一歩となります。</p></section>

  <section class="lp-section alt" id="sec-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2>各業者個別解説</h2>
      <p class="section-lede">各サービスの特徴を公式サイトの情報に基づき中立的に解説します。</p>

      <h3>退職代行Jobs</h3>
      <p>「退職代行Jobs」は、合同労働組合が運営する退職代行サービスです。労働組合法に基づく団体交渉権を持っているため、依頼者に代わって会社と有給消化や退職日の調整などの交渉を行うことが可能です。</p>
      <p>料金は推定 ¥27,000 から ¥29,000（税込）で、追加料金は原則として発生しないとされています。<br>24 時間 365 日、LINE やメールでの相談に対応しており、深夜や早朝の連絡も可能です。<br>また、退職が完了するまでの期間、相談回数に制限がない点も特徴の一つです。<br>万が一退職できなかった場合の返金保証制度も設けられています。<br>詳細な料金やサービス内容、保証の適用条件については、利用前に公式サイトでご確認ください。</p>
      <PRBadge pageSlug="comparison" label="「退職代行Jobs」公式サイトはこちら（PR）" />

      <h3>退職代行ガーディアン</h3>
      <p>「退職代行ガーディアン」は、東京都労働委員会に認証されている法適合の「東京労働経済組合」が運営しています。<br>労働組合として、退職に関する連絡や交渉を依頼者の代理で行います。<br>料金は雇用形態を問わず一律で、推定 ¥24,800（税込）とされています。<br>追加料金は発生しないと明記されています。<br>365 日、LINE と電話での相談に対応しているのが特徴です。<br>詳細な料金やサービス内容については、公式サイトでご確認ください。</p>
      <p><a href="#" target="_blank" rel="noopener nofollow">サービス名で公式サイトをご検索ください</a></p>

      <h3>退職代行モームリ</h3>
      <p>「退職代行モームリ」は、労働組合と提携してサービスを提供しています。<br>料金は正社員・契約社員の場合、推定 ¥22,000（税込）とされており、アルバイト・パートの場合は料金が異なる可能性があります。<br>24 時間対応を掲げており、相談は LINE や電話で受け付けています。<br>返金保証制度も用意されています。<br>料金体系や保証内容の詳細については、公式サイトでご確認ください。</p>
      <p><a href="#" target="_blank" rel="noopener nofollow">サービス名で公式サイトをご検索ください</a></p>

      <h3>弁護士法人みやびの退職代行</h3>
      <p>「弁護士法人みやび」が直接運営する退職代行サービスです。<br>弁護士が業務を行うため、退職意思の伝達だけでなく、未払い給与や残業代、退職金の請求、会社からの損害賠償請求への対応といった法律業務全般をカバーしています。<br>料金は推定 ¥55,000（税込）で、相談は LINE、メール、電話で可能です。<br>法的なトラブルに発展する可能性がある場合に適した選択肢と言えます。<br>最新の料金や対応範囲については、公式サイトでご確認ください。</p>
      <p><a href="#" target="_blank" rel="noopener nofollow">サービス名で公式サイトをご検索ください</a></p>

      <h3>弁護士法人ガイア</h3>
      <p>「弁護士法人ガイア」も、弁護士が直接対応する退職代行サービスです。<br>弁護士法人みやびと同様に、単純な退職代行にとどまらず、慰謝料請求や未払い賃金の交渉など、法的な手続きを含めた広範なサポートを提供しています。<br>料金は推定 ¥55,000（税込）とされています。<br>全国対応で、LINE での相談が可能です。<br>複雑な事案や法的な交渉が必要なケースでの利用が想定されます。<br>サービス詳細については、公式サイトでご確認ください。</p>
      <p><a href="#" target="_blank" rel="noopener nofollow">サービス名で公式サイトをご検索ください</a></p>

      <h3>退職代行SARABA</h3>
      <p>「退職代行SARABA」は、労働組合の組合員として退職代行サービスを提供しています。<br>料金は一律で推定 ¥24,000（税込）とされており、追加料金はかからないとされています。<br>24 時間 365 日対応で、LINE、メール、電話での相談が可能です。<br>返金保証制度も設けています。<br>労働組合として会社との交渉が可能です。<br>最新の情報や保証の条件は、公式サイトでご確認ください。</p>
      <p><a href="#" target="_blank" rel="noopener nofollow">サービス名で公式サイトをご検索ください</a></p>
      <BannerAB pageSlug="comparison" position="middle" />
    </div>
  </section>

  <section class="lp-section"><h2>運営主体別の料金・対応範囲の具体的な比較ポイント</h2><p>運営主体ごとの特徴を料金と対応範囲から具体的に比較します。<br>まず「民間企業」は、料金が2〜3万円台と比較的安価な点が特徴ですが、対応は退職意思の伝達に限定されます。<br>会社側が退職を拒否したり、交渉が必要になったりした場合は対応が難しいとされます。<br>「労働組合」は、料金が2.5〜3.5万円台で、団体交渉権を行使して有給消化や未払い残業代の請求といった交渉が可能です。<br>多くの会社員が抱える問題に対応できるため、有力な選択肢とされます。<br>「弁護士法人」は、料金が5万円以上と高額になりますが、損害賠償請求や裁判といった法的手続きまで一任できる唯一の選択肢です。<br>国民生活センターへの相談事例には、業者とのトラブルも報告されており、各主体の権限を理解した上での比較検討が不可欠です。</p><ul><li><strong>民間企業:</strong> 料金は安価だが、交渉は不可。単純な意思伝達のみ。</li><li><strong>労働組合:</strong> 団体交渉権があり、有給や未払い賃金の交渉が可能。</li><li><strong>弁護士法人:</strong> 料金は高額だが、訴訟を含めた全ての法律行為に対応可能。</li></ul><div class="benefit-summary" style="background:#f5f5dc;padding:1rem;border-left:4px solid #d4a373;margin:1rem 0;"><strong>💡 この比較情報を参考にするメリット (★544 ②):</strong><ul><li>自身の状況に最適な業者を比較検討することで、不要な費用や時間をかけずに退職手続きを進められる可能性が高まります。</li><li>運営主体ごとの対応範囲の違いを理解することで、有給消化や未払い賃金の交渉といった、自身の希望が実現可能か事前に判断しやすくなります。</li><li>弁護士法や労働組合法といった法的根拠に基づいてサービスを比較することで、「非弁行為」などのトラブルを避け、より安心して依頼先を選定することが期待できます。</li></ul></div></section>

  <section class="lp-section faq alt" id="sec-faq">
    <div class="container">
      <p class="section-num">SECTION / 06</p>
      <h2>退職代行に関するよくある質問 (FAQ)</h2>
      <div class="faq">
        {faq.map((item) => (
          <details><summary>{item.q}</summary><div><p set:html={item.a} /></div></details>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-soudan">
    <div class="container">
      <p class="section-num">SECTION / 07</p>
      <h2>困ったときの公的相談窓口</h2>
      <p class="section-lede">退職に関する悩みは、公的な窓口に相談することも可能です。無料で相談できる機関もありますので、状況に応じて活用を検討してください。</p>
      <ul>
        <li><strong>総合労働相談コーナー</strong>: 全国の労働局・労働基準監督署内に設置されており、解雇、賃金不払い、パワハラなど、あらゆる労働問題について専門の相談員が対応してくれます。</li>
        <li><strong>法テラス（日本司法支援センター）</strong>: 国によって設立された法的トラブル解決のための「総合案内所」です。経済的に余裕がない方でも、無料の法律相談や弁護士費用の立替え制度を利用できる場合があります。</li>
        <li><strong>みんなの人権110番</strong>: 法務省が管轄する人権相談窓口です。いじめや差別、虐待、パワハラなどの人権問題に関する相談を受け付けています。</li>
        <li><strong>こころの健康相談統一ダイヤル</strong>: 厚生労働省が支援する、心の健康に関する相談窓口です。精神的な不調を感じている場合に相談できます。</li>
      </ul>
    </div>
  </section>

  <section class="lp-section alt" id="sec-summary">
    <div class="container">
      <p class="section-num">SECTION / 08</p>
