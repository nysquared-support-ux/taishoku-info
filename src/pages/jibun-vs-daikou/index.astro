---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '自分で退職 vs 退職代行｜判断の5軸とどちらを選ぶべきかの整理（2026年版・PR）';
const description = '自分で退職を伝える場合と退職代行を使う場合の判断軸 (時間/費用/ストレス/リスク/法的権限) を5軸で整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '自分で退職 vs 代行' },
];

const faq = [
  { q: '会社との関係が良好な場合でも、退職代行を使うメリットはありますか？', a: '関係が良好であればご自身で伝えるのが一般的です。しかし、強い引き止めが予想される場合や退職理由を詳しく話したくない場合には、第三者を介する代行サービスが精神的負担を軽減する選択肢となり得ます。最終的な判断は個人の状況によるとされます。' },
  { q: '自分で退職を伝える場合と退職代行、法的な有効性に違いはありますか？', a: 'どちらの方法でも退職の意思表示は法的に有効です。民法第627条では、期間の定めのない雇用契約は2週間前の申し入れで解約できると定めています。退職代行は、この意思表示を本人の代理人として会社に伝える役割を担うものと整理されます。' },
  { q: '退職代行に依頼した場合、会社から直接連絡が来る可能性はありますか？', a: '多くの退職代行サービスでは「本人へは連絡しないように」と会社側に伝えます。しかし、これに法的な強制力はないため、会社によっては連絡が来る可能性もゼロではありません。その際の対応方法も事前に代行業者と相談しておくことが推奨されます。' },
  { q: '自分で退職を伝えた際に、会社から損害賠償を請求されるリスクはありますか？', a: '適法な手続き（例：2週間前の告知）を踏んでいれば、退職を理由に損害賠償を請求されることは通常ありません。ただし、無断欠勤や引き継ぎの意図的な放棄など、会社に実害を与えた場合は別です。詳細は厚生労働省の公開情報などで確認できます。' },
  { q: '結局、どちらを選ぶべきか判断する最大のポイントは何ですか？', a: '最も重要な判断軸は「ご自身の精神的・時間的コストをどこまで許容できるか」です。会社と直接対話するストレスが少ないなら自分で、強い引き止めやハラスメントが懸念されるなら代行サービス、というように状況に応じた選択が推奨されます。' },
];
---

