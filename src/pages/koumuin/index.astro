---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '公務員の退職代行｜国家公務員・地方公務員の手続きと業者選び5軸（2026年版・PR）';
const description = '国家公務員・地方公務員が退職を検討する際の、服務規程・退職手続き・退職代行活用5軸を整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '公務員の退職' },
];

const faq = [
  { q: '公務員でも退職代行サービスを利用することは法的に可能ですか？', a: 'はい、利用可能です。退職の意思表示は民法第627条で労働者の権利として認められており、これは公務員にも適用されると解されています。弁護士が代理人として退職手続きを行うことは法的に問題なく、服務規程を考慮しつつ円満な退職を目指すために活用されています。' },
  { q: '国家公務員と地方公務員で、退職代行を利用する際の手続きに違いはありますか？', a: '基本的な流れは同様ですが、根拠となる法律が異なります。国家公務員は国家公務員法、地方公務員は地方公務員法が適用されます。また、所属する省庁や自治体独自の条例・内規が存在する場合があるため、公務員の退職実績が豊富な業者に相談し、個別の状況に合わせた対応を確認することが重要です。' },
  { q: '退職代行を利用した場合、共済組合の手続きや失業手当はどうなりますか？', a: '退職代行は退職の意思表示や事務連絡を代行しますが、共済組合の資格喪失手続きや、雇用保険の基本手当に相当する失業手当の申請は、原則として本人が行う必要があります。ただし、手続きに必要な書類の請求などは業者がサポートしてくれる場合が多く、詳細は各共済組合やハローワークの窓口で確認することが推奨されます。' },
  { q: '退職代行を利用したことが原因で、懲戒免職になるリスクはありますか？', a: '退職代行の利用自体を理由として懲戒免職処分が下される可能性は極めて低いとされます。懲戒処分は国家公務員法や地方公務員法に定められた重大な服務規律違反など、特定の事由に該当する場合に限られます。適法に退職手続きを進める限り、通常は問題になりません。' },
  { q: '公務員が退職代行を選ぶ際に、最も重視すべき点は何ですか？', a: '公務員特有の服務規程や複雑な手続きに精通している、実績豊富な業者を選ぶことが最も重要です。特に弁護士が運営するサービスは、非弁行為のリスクがなく、万一の交渉事にも対応できるため安心感が期待できます。国民生活センターも退職代行に関する注意喚起を行っており、契約前の十分な確認が求められます。' },
];
---

<RichLayout title={title} description={description} publishedDate="2026-05-20" modifiedDate="2026-05-20" breadcrumb={breadcrumb} faq={faq}>
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">退職代行 / 公務員</span>
      <h1 id="fv-h1"><span class="accent">公務員の退職代行</span><br />国家公務員・地方公務員の手続きと業者選び5軸</h1>
      <p class="lede">公務員 (国家公務員・地方公務員) の退職は「服務規程」「退職手続きの定型化」「退職手当の確認」を踏まえた計画判断が推奨されます。本記事では公開情報・公的機関データをもとに、公務員退職を計画的に進めるための5軸と退職代行活用を中立的に整理します。</p>
      <ul class="fv-bullets">
        <li>国家公務員法・地方公務員法と退職の自由</li>
        <li>退職願・任命権者承認の手続き整理</li>
        <li>退職手当 (雇用保険対象外) の事前確認</li>
        <li>公務員対応経験のある業者選び5軸</li>
      </ul>
      <PRBadge pageSlug="koumuin" />
      <div class="fv-meta">
        <span><b>公開日</b> 2026-05-20</span><span><b>最終更新</b> 2026-05-20</span>
        <span><b>編集</b> NY-squared 編集部</span><span><b>所要</b> 約 6 分</span>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-1" aria-labelledby="h2-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2 id="h2-1">公務員退職の前提整理 (5 ポイント)</h2>
      <p class="section-lede">公開情報・公的機関データの整理として、公務員退職検討で押さえておくべき前提を 5 ポイントに整理します。</p>
      <ol>
        <li><strong>退職の自由</strong>: 公務員も民間と同様に退職の自由が認められる (国家公務員法・地方公務員法の規定および民法627条の準用)</li>
        <li><strong>退職願の提出</strong>: 任命権者宛の退職願提出が一般的とされる (民間の「退職届」と区別)</li>
        <li><strong>承認手続き</strong>: 任命権者の承認が必要とされる場合があり、民間より手続きが定型化</li>
        <li><strong>退職手当</strong>: 雇用保険対象外・国家公務員退職手当法等に基づく退職手当が支給される</li>
        <li><strong>守秘義務</strong>: 退職後も守秘義務 (国公法100条・地公法34条) が継続するため業者選定で重要</li>
      </ol>
      <BannerAB pageSlug="koumuin" position="hero" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2>公務員退職時の業者選び 5 軸</h2>
      <div class="card-grid">
        <div class="card"><h3>① 公務員対応経験</h3><p>公務員特有の服務規程・退職願形式に対応できる業者経験が選択肢として整理されます。</p></div>
        <div class="card"><h3>② 即日意思伝達</h3><p>即日対応可能な業者が選択肢になります (任命権者の承認手続きと並行)。</p></div>
        <div class="card"><h3>③ 守秘義務への配慮</h3><p>退職後も継続する守秘義務を踏まえた業者対応 (情報取扱い) が重要とされます。</p></div>
        <div class="card"><h3>④ 料金透明性</h3><p>追加費用の有無を事前確認。見積書面取得が推奨されます。</p></div>
        <div class="card"><h3>⑤ 退職手当手続きサポート</h3><p>退職手当の請求書類・職場との調整について業者がサポートできるか確認します。</p></div>
      </div>
    </div>
  </section>

  <section class="lp-section"><h2>公務員の退職代行利用における基礎知識</h2><p>公務員が退職を希望する際、民間企業の従業員とは異なる特有の課題に直面することがあります。<br><br>全体の奉仕者としての立場を定める国家公務員法や地方公務員法に基づく服務規程が、退職の意思を伝えにくくする心理的な障壁となるケースが少なくありません。<br><br>また、厳格な組織文化から、上司への直接の申し出が困難な状況も想定されます。<br><br>退職代行サービスは、こうした状況で本人に代わり退職の意思を職場に伝え、必要な事務手続きを調整する役割を担います。<br><br>民法第627条では期間の定めのない雇用契約の解約について定めており、これは公務員の退職意思表示の根拠の一つと解釈されています。<br><br>公務員向けの退職代行は、単に意思を伝えるだけでなく、有給休暇の消化や貸与品の返却といった具体的な手続きについても、法令や慣例に基づき円滑に進めるサポートを提供することが期待されます。</p></section>

  <section class="lp-section alt" id="sec-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2>公務員退職の進め方 (3 ステップ)</h2>
      <p class="section-lede">公開情報・公的機関データの整理として、公務員退職を計画的に進めるステップを 3 つに整理します。</p>
      <div class="counter-box">
        <h3>📌 計画的に進める 3 ステップ</h3>
        <div class="row"><b>STEP 1. 服務規程・退職手当の事前確認 (退職表明 1 ヶ月前)</b><span>所属機関の服務規程・退職願の形式・退職手当の支給条件を人事窓口で確認。守秘義務範囲も整理。</span></div>
        <div class="row"><b>STEP 2. 業者選定 (退職表明 2 週間前)</b><span>公務員対応経験・服務規程対応・守秘義務配慮の 3 軸で 2-3 社に絞込。無料相談 (LINE/電話) で対応可否を確認。</span></div>
        <div class="row"><b>STEP 3. 依頼実行 (平日午前中)</b><span>平日午前中の依頼で任命権者対応が円滑になるとされる。詳細は <a href="/touji/">即日・当日対応ページ</a> 参照。</span></div>
        <p style="margin-top:12px;font-size:13px;color:var(--c-text-sub,#4a5568);">※公開情報・公的機関データの整理 (推定値含む)・個別案件は弁護士・各業者へご相談ください。</p>
      </div>
    </div>
  </section>

  <section class="lp-section"><h2>公務員向け退職代行の具体的な活用手順と注意点</h2><p>公務員が退職代行サービスを利用する際は、民間企業の場合以上に慎重な業者選びと手順の理解が求められます。<br><br>公務員の退職案件に対応した実績が豊富な、特に弁護士が運営するサービスを選ぶことが重要とされます。<br><br>弁護士であれば、非弁行為（弁護士法第72条で禁止）のリスクがなく、万が一の交渉事にも法的な代理人として対応できるためです。<br><br>具体的な活用手順は以下の通り整理されます。</p><ul><li><strong>1. 相談と業者選定:</strong> 複数の業者に相談し、公務員の退職実績、料金体系、サービス範囲を確認します。特に弁護士法人や労働組合が運営する業者は、交渉の代理権を持つため、より安心して依頼できる可能性があります。</li><li><strong>2. ヒアリングと方針決定:</strong> 担当者と、現在の職務状況、所属、退職希望日、有給休暇の残日数、貸与品など詳細な情報を共有し、具体的な退職シナリオを策定します。</li><li><strong>3. 職場への連絡と手続き代行:</strong> 依頼に基づき、業者が代理人として職場（人事課など）に連絡し、退職の意思を伝えます。その後、退職届の提出、貸与品の返却、離職票や共済組合関連書類の請求といった事務手続きを代行またはサポートします。</li></ul><p>注意点として、共済組合からの脱退手続きや、将来の年金に関する手続きは、最終的に本人が行う必要がある点を理解しておくことが大切です。<br><br>また、消費者庁は、退職代行サービスに関する注意喚起を行っており、契約内容を十分に確認することの重要性を指摘しています。<br><br>信頼できる業者を選ぶことで、これらの手続きも円滑に進めるための助言が期待できます。</p><div class="benefit-summary" style="background:#f5f5dc;padding:1rem;border-left:4px solid #d4a373;margin:1rem 0;"><strong>💡 このサービスを検討するメリット (★544 ②):</strong><ul><li>上司や同僚と直接対話することなく退職手続きを進められるため、精神的負担の大幅な軽減が期待できます。</li><li>公務員特有の複雑な手続きや服務規程について、専門的な知見を持つ担当者からのサポートを得られる可能性があります。</li><li>弁護士による代行の場合、法的な正当性を持って円満な退職を実現できる可能性が高まり、トラブル発生時の安心感につながります。</li></ul></div></section>

  <section class="lp-section alt" id="sec-summary">
    <div class="container">
      <p class="section-num">SECTION / 06</p>
      <h2>まとめ</h2>
      <p>公務員 (国家公務員・地方公務員) の退職は ①服務規程・退職願形式の確認 ②任命権者承認手続きの整理 ③退職手当 (雇用保険対象外) の事前確認・の 3 ステップが基本軸とされます。<br><br>民間と比べ手続きが定型化されているため、公務員対応経験・服務規程対応・守秘義務配慮を提供できる弁護士運営の退職代行が選択肢として、公開情報で整理されている計画的な進め方の一例とされます。</p>
      <p><strong>状況別の推奨形態</strong>: ① <strong>服務規程・守秘義務対応必須</strong> → 弁護士運営 ② <strong>シンプルな意思伝達のみ</strong> → 公務員対応経験のある民間運営 (¥20,000-30,000帯)。</p>
      <p style="font-size:13px;color:var(--c-text-mute,#6b7280);">※即日対応は <a href="/touji/">即日・当日対応ページ</a> ・5 社比較は <a href="/osusume-hikaku/">おすすめ比較</a> もあわせてご参照ください。本記事は法的助言ではなく、特定業者を推奨するものでもありません。</p>
      <PRBadge pageSlug="koumuin" label="退職代行サービスの公式サイトで無料相談する（PR）" />
    </div>
  </section>

  <section class="lp-section" id="sec-policy">
    <div class="container">
      <p class="section-num">SECTION / 07</p>
      <h2>編集ポリシー (情報源・更新日・E-E-A-T)</h2>
      <ul>
        <li><strong>情報源</strong>: 政府公式 e-Gov 法令検索 (国家公務員法・地方公務員法・民法・労働基準法・弁護士法) ・人事院公式サイト ・各退職代行業者公式サイト</li>
        <li><strong>編集方針</strong>: 一次情報優先 (法令は e-Gov 直接リンク) ・断定表現を避け推定値・公開情報の整理として記述</li>
        <li><strong>運営者</strong>: NY-squared (個人事業) <a href="/operator-info/">運営情報ページ</a> 参照</li>
        <li><strong>E-E-A-T 4 原則</strong>: Experience (退職代行・公務員制度の公開情報整理) ・Expertise (法令引用) ・Authoritativeness (政府公式 + 業者公式の一次情報のみ) ・Trustworthiness (PR 表記 + 推定値明示 + 法的助言ではない注記)</li>
      </ul>

      <h2>出典・参考情報 (法令・公的機関・公開情報)</h2>
      <ul>
        <li><a href="https://www.mhlw.go.jp/" target="_blank" rel="noopener">厚生労働省</a> (労働相談窓口情報)</li>
        <li><a href="https://www.jinji.go.jp/" target="_blank" rel="noopener">人事院</a> (国家公務員制度・退職手当)</li>
        <li><a href="https://elaws.e-gov.go.jp/document?lawid=323AC0000000120" target="_blank" rel="noopener">国家公務員法 (e-Gov)</a></li>
        <li><a href="https://elaws.e-gov.go.jp/document?lawid=325AC0000000261" target="_blank" rel="noopener">地方公務員法 (e-Gov)</a></li>
        <li><a href="https://elaws.e-gov.go.jp/document?lawid=129AC0000000089" target="_blank" rel="noopener">民法第627条 (退職の権利・e-Gov)</a></li>
        <li>各退職代行業者公式サイト・最新情報は各公式サイトでご確認ください</li>
      </ul>
      <p style="font-size:12px;color:var(--c-text-mute,#6b7280);margin-top:16px;">
        ※本記事は2026年5月時点の公開情報をもとに作成。最新の法令・サービス内容・公的支援内容は各公式サイト・人事院・所属機関でご確認ください。本ページはアフィリエイト広告（PR）を含みます。
      </p>
    </div>
  </section>

  <section class="lp-section alt" id="sec-asp-pr" aria-labelledby="h2-asp-pr">
    <div class="container">
      <p class="section-num">SECTION / PR・広告</p>
      <h2 id="h2-asp-pr">【PR・広告】退職代行Jobs (株式会社アレス) の公開情報整理</h2>
      <p class="section-lede"><strong>本セクションは PR・広告枠</strong> です。アフィリエイト広告として「退職代行Jobs (株式会社アレス)」の公開情報を整理しています。他事業者との優劣判断ではなく、広告主の公開情報として参照ください。</p>
      <div class="branch-grid">
      <article class="branch"><span class="tag">特徴①</span><h4>退職代行Jobs</h4><p>退職代行Jobs (株式会社アレス運営) は退職代行サービスの一つとされる傾向。会社との連絡を代行する選択肢として検討対象とされています。</p></article>
      <article class="branch"><span class="tag">特徴②</span><h4>LINE相談対応</h4><p>LINE での相談対応の傾向。気軽に相談できる選択肢とされる傾向。</p></article>
      <article class="branch"><span class="tag">特徴③</span><h4>顧問弁護士監修</h4><p>顧問弁護士監修の傾向。法的トラブル懸念のある方の検討材料が一般的です。</p></article>
      <article class="branch"><span class="tag">特徴④</span><h4>全国対応</h4><p>全国対応の傾向。地方在住者も利用可能な選択肢のケースが多く見られます。</p></article>
      <article class="branch"><span class="tag">特徴⑤</span><h4>プライバシー配慮</h4><p>個人情報保護法遵守の傾向。会社・家族にバレにくい配慮があると公表されています。</p></article>
      <article class="branch"><span class="tag">注意</span><h4>事前確認推奨事項</h4><p>具体的料金・対応範囲・成功事例は公式公開情報で確認推奨。「100%退職成功」等の断定は不可とされています。</p></article>
      </div>
      <div class="cta-block"><p class="cta-note"><span class="pr-tag">PR</span>退職代行Jobs (株式会社アレス) の最新の条件は公式サイトでご確認ください。</p><BannerAB pageSlug={"enhance-cta"} position="enhance" /><p class="btn-cta-sub">※ 公式サイトに遷移します。</p></div>
    </div>
  </section>

  <section class="lp-section" id="sec-koteki-laws" aria-labelledby="h2-koteki-laws">
    <div class="container">
      <p class="section-num">SECTION / 公的窓口・関連法令</p>
      <h2 id="h2-koteki-laws">公的窓口・関連法令</h2>
      <p class="section-lede">トラブル時・疑問時は公的窓口の活用が推奨されます。</p>
      <ul>
        <li><a href="https://www.mhlw.go.jp/general/sosiki/chihou/" target="_blank" rel="noopener">総合労働相談コーナー</a> - 厚生労働省・労働相談</li>
