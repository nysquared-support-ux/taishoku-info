/**
 * 退職代行 口コミ LP (taishoku-info・★326 DRY kaisha-renraku 流用)
 * sv 推定 5,400 (★273 70+ クリア候補・A2 8.0・本日 5/15 [tPeehQZ6O7] LP 化)
 * ★508 RichLayout 化 [fFHYHvUqIu] 2026-05-18 (content 100%保持・検証済shippaiパターン)
 */
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行 口コミ・評判完全ガイド｜主要 5 サービスの実利用者口コミ整理（2026年5月時点・公開情報整理・PR）';
const description = '退職代行サービス利用を検討中の方へ。主要 5 サービス (退職代行Jobs / モームリ / 弁護士法人みやびの退職代行 / 退職代行ガーディアン / 男の退職代行) の Google レビュー / みん評 / X 投稿等の公開口コミを整理した情報提供記事です (PR・アフィリエイト広告を含みます)。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行ガイド', url: '/' },
  { name: '退職代行 口コミガイド' },
];

const faq = [
  { q: '退職代行の口コミは信用できますか?', a: '一般的に Google レビュー・みん評・X 投稿等の公開口コミは複数ソースで比較することが推奨されます。極端に高評価のみ・極端に低評価のみのサービスは要注意・幅広い評価分布のサービスの方が信頼性が高い傾向とされています。' },
  { q: '口コミでよく評価される退職代行サービスはありますか?', a: '一般的に退職代行Jobs / モームリ / 弁護士法人みやびの退職代行 / 退職代行ガーディアン等が評価されている事例が公開口コミで観察されますが、個別状況により最適な選択は異なるため、複数比較が推奨されます。' },
  { q: '悪い口コミにはどんなものがありますか?', a: '一般的に「対応が機械的」「退職完了後のフォロー不足」「料金が高い」「会社との交渉ができない (弁護士でない場合)」等の口コミが観察されます。これらは各サービスの仕様に関連する点も多く、利用前確認が推奨されます。' },
  { q: '弁護士法人と一般の退職代行の口コミは違いますか?', a: '一般的に弁護士法人 (弁護士法人みやび等) は料金が高い (5-7 万円台) が交渉可能・トラブル対応可能との口コミが観察されます。一般退職代行 (退職代行Jobs / モームリ等) は料金が安い (2-3 万円台) が交渉不可との口コミ傾向があります。' },
  { q: '口コミ以外で退職代行を選ぶ基準は?', a: '一般的に ① 料金体系の透明性 ② 弁護士法人か一般かの違い ③ 対応スピード (即日対応有無) ④ 24 時間対応 ⑤ 返金保証 ⑥ アフターサポート (転職支援等) の 6 軸で総合判断することが推奨されます。' },
];
---

<RichLayout title={title} description={description} publishedDate="2026-05-15" modifiedDate="2026-05-18" breadcrumb={breadcrumb} faq={faq}>
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">退職代行 / 口コミ・評判</span>
      <h1 id="fv-h1"><span class="accent">退職代行 口コミ・評判完全ガイド</span><br />主要 5 サービスの実利用者口コミ整理</h1>
      <p class="lede">退職代行サービスの口コミは Google レビュー / みん評 / X 投稿等の公開ソース複数で比較することが推奨されます。サービス選定は口コミだけでなく 料金 / 弁護士法人 vs 一般 / 対応スピード / 返金保証 / アフターサポート の 6 軸で総合判断することが推奨されます。</p>
      <ul class="fv-bullets">
        <li>主要5サービスの公開口コミ整理</li>
        <li>良い口コミ / 悪い口コミ (公平掲載)</li>
        <li>口コミ評価軸 6 種</li>
        <li>口コミ確認時の注意点5点</li>
      </ul>
      <PRBadge pageSlug="kuchikomi" />
      <p class="compare-note">※ 本記事の口コミは ① <a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/koyou_roudou/roudoukijun/zigyonushi/taishoku/index.html" target="_blank" rel="noopener">厚生労働省「退職に関する Q&amp;A」</a> ② <a href="https://www.nichibenren.or.jp/" target="_blank" rel="noopener">日本弁護士連合会</a> ③ 公開口コミサイト (Google レビュー・みん評・X 投稿サンプル) ④ 各退職代行サービス公式サイト公開情報 を整理した <strong>2026 年 5 月時点の一般論</strong>であり、断定的事実ではありません。最終確認日: 2026-05-15。</p>
      <div class="fv-meta">
        <span><b>公開日</b> 2026-05-15</span><span><b>最終更新</b> 2026-05-18</span>
        <span><b>編集</b> NY-squared 編集部</span><span><b>所要</b> 約 5 分</span>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2>主要 5 サービスの口コミ整理 (公開情報整理)</h2>
      <div class="counter-box">
        <h3>📌 読者別 判断分岐 (公開情報整理)</h3>
        <div class="row"><b>料金重視の方</b><span>一般退職代行 (退職代行Jobs / モームリ等) の口コミ + 料金 2-3 万円台のサービス検討推奨</span></div>
        <div class="row"><b>会社との交渉が必要な方</b><span>弁護士法人 (弁護士法人みやびの退職代行等) の口コミ + 料金 5-7 万円台のサービス検討推奨</span></div>
        <div class="row"><b>即日退職希望の方</b><span>24 時間対応 + 即日対応サービスの口コミ確認推奨</span></div>
        <div class="row"><b>トラブル不安な方</b><span>返金保証 + アフターサポート充実サービスの口コミ確認推奨</span></div>
        <p style="margin-top:12px;font-size:13px;color:var(--c-text-sub,#4a5568);">※ 各読者層に最適な判断軸は個別状況により大きく異なります。具体的判断は各サービスのカウンセリングへの相談を推奨します。</p>
      </div>
      <ul>
        <li><strong>退職代行Jobs</strong>: 料金 27,000 円台・労働組合提携で交渉可能・口コミは「対応が早い」「LINE 連絡で気軽」(Google レビュー / みん評等)</li>
        <li><strong>モームリ</strong>: 料金 22,000 円台 (バイト・パート 12,000 円)・労働組合提携・口コミは「料金が安い」「24 時間対応」「アルバイト対応あり」</li>
        <li><strong>弁護士法人みやびの退職代行</strong>: 料金 55,000 円台・弁護士直接対応・口コミは「トラブル対応可能」「未払い残業代請求も依頼可」</li>
        <li><strong>退職代行ガーディアン</strong>: 料金 24,800 円台・労働組合提携・口コミは「東京都労働委員会認証」「正社員 / アルバイト同額」</li>
        <li><strong>男の退職代行</strong>: 料金 26,800 円台・労働組合提携・男性専門・口コミは「男性視点のサポート」「業種別対応」</li>
      </ul>
      <BannerAB pageSlug="kuchikomi" position="hero" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2>良い口コミに多い評価ポイント (公開情報整理)</h2>
      <ul>
        <li><strong>対応スピード</strong>: 「LINE 連絡から数時間で着手」「即日退職できた」(Google レビュー / みん評)</li>
        <li><strong>料金透明性</strong>: 「追加費用なし」「事前見積通り」(複数サービス共通)</li>
        <li><strong>会社との連絡不要</strong>: 「上司と顔を合わせずに退職できた」(精神的負担軽減)</li>
        <li><strong>返金保証</strong>: 「退職できなかったら全額返金で安心」</li>
        <li><strong>アフターサポート</strong>: 「転職支援サービス紹介あり」「失業保険手続きアドバイス」</li>
      </ul>
      <h2>悪い口コミに多い指摘 (公平性のため正直掲載)</h2>
      <ul>
        <li><strong>対応の機械的さ</strong>: 「マニュアル対応で温かみが薄い」(複数サービスでの口コミ)</li>
        <li><strong>退職後のフォロー不足</strong>: 「退職完了後の連絡がない」「離職票発行確認サポートなし」</li>
        <li><strong>料金 vs 弁護士法人差</strong>: 「一般退職代行は会社との交渉不可・追加トラブル時に弁護士法人へ依頼し直し」</li>
        <li><strong>営業時間限定</strong>: 「24 時間と謳いつつ深夜対応が限定的」</li>
        <li><strong>業種別対応の差</strong>: 「公務員 / 特殊業種は対応外」「正社員のみで派遣・契約社員は対象外」(一部サービス)</li>
      </ul>
      <BannerAB pageSlug="kuchikomi" position="middle" />
    </div>
  </section>

  <section class="lp-section" id="sec-3">
    <div class="container">
      <p class="section-num">SECTION / 03</p>
      <h2>口コミ評価軸 6 種 (公開情報整理)</h2>
      <div class="compare-wrap">
        <table class="compare">
          <thead><tr><th>評価軸</th><th>確認ポイント</th></tr></thead>
          <tbody>
            <tr><td>料金体系</td><td>追加費用の有無・正社員/アルバイト料金差・返金保証条件</td></tr>
            <tr><td>弁護士法人 vs 一般</td><td>会社との交渉可否・未払い残業代請求可否</td></tr>
            <tr><td>対応スピード</td><td>即日対応 / 翌営業日 / 24 時間対応の実体</td></tr>
            <tr><td>返金保証</td><td>退職不成立時の保証範囲・条件</td></tr>
            <tr><td>アフターサポート</td><td>転職支援・失業保険手続き・離職票発行サポート</td></tr>
            <tr><td>対応業種</td><td>正社員/契約社員/派遣/アルバイト/公務員等の対応範囲</td></tr>
          </tbody>
        </table>
      </div>
      <h2>口コミ確認時の注意点</h2>
      <ol>
        <li><strong>複数ソース確認</strong>: Google / みん評 / X 等の複数ソースで横断確認 (一サイトでの極端評価に依存しない)</li>
        <li><strong>投稿時期確認</strong>: 直近 3-6 ヶ月の口コミを優先 (古い口コミはサービス内容変更可能性)</li>
        <li><strong>サクラ口コミ識別</strong>: 投稿頻度 / 文体パターン / 過度な絶賛・批判は注意</li>
        <li><strong>料金変動確認</strong>: 口コミ時の料金と現在料金が異なる可能性</li>
        <li><strong>自分の業種・状況との一致</strong>: 「正社員」「アルバイト」「業種別」等の状況一致を確認</li>
      </ol>
      <BannerAB pageSlug="kuchikomi" position="footer" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2>反例: 退職代行を使わない選択肢 (公開情報整理)</h2>
      <div class="counter-box">
        <h3>📌 退職代行を使わない選択肢</h3>
        <div class="row"><b>自分で退職交渉</b><span>料金ゼロ・但し精神的負担あり</span></div>
        <div class="row"><b>労働組合相談</b><span>無料相談あり・但し時間かかる傾向</span></div>
        <div class="row"><b>弁護士個別相談</b><span>単発相談 5,000-10,000 円・但し継続対応は別途</span></div>
        <div class="row"><b>労働基準監督署相談</b><span>無料・但し直接退職代行はしない (情報提供のみ)</span></div>
        <p style="margin-top:12px;font-size:13px;color:var(--c-text-sub,#4a5568);">※ 退職代行は手段の一つです。状況により最適な選択肢は異なります。</p>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-faq">
    <div class="container">
      <p class="section-num">SECTION / 05</p>
      <h2>よくある質問（FAQ）</h2>
      <div class="faq">
        {faq.map((item) => (
          <details><summary>{item.q}</summary><div><p>{item.a}</p></div></details>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-section alt" id="sec-summary">
    <div class="container">
      <p class="section-num">SECTION / 06</p>
      <h2>まとめ (一般的傾向・個別判断はカウンセリング相談を推奨)</h2>
      <ul>
        <li>退職代行口コミは複数ソース (Google / みん評 / X) で横断確認が推奨</li>
        <li>主要 5 サービス: 退職代行Jobs / モームリ / 弁護士法人みやび / ガーディアン / 男の退職代行</li>
        <li>判断軸 6 種: 料金 / 弁護士法人 vs 一般 / 対応スピード / 返金保証 / アフターサポート / 対応業種</li>
        <li>口コミ確認注意点: 複数ソース / 投稿時期 / サクラ識別 / 料金変動 / 状況一致</li>
        <li><strong>YMYL リスク認識</strong>: 退職は就業判断に直結する重要事項です。本記事は公開情報整理であり、個別保証・成功確約ではありません</li>
      </ul>
