---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const slug = "ninshin-shussan-taishoku";
const title = "妊娠・出産退職の退職代行ガイド｜マタハラ対応と公的保護（2026年6月時点・PR）";
const description = "妊娠・出産を理由に退職を検討する方向けに、マタハラ対応・公的保護・退職代行の活用を公開情報をもとに中立に整理した情報提供記事です（PR・アフィリエイト広告を含みます）。";
const breadcrumb = [
  { name: "ホーム", item: "/" },
  { name: "退職代行", item: "/" },
  { name: title, item: `/${slug}/` }
];
const faq = [
  { q: '妊娠中に退職するのは違法ではありませんか？', a: '労働者本人が自由意思で退職する場合は違法ではありません。会社からの妊娠を理由とする解雇は法律で禁じられています。' },
  { q: 'マタハラを受けた場合の対処は？', a: '都道府県労働局・労働基準監督署への相談が推奨されるとされています。退職代行サービスへの相談も選択肢とされます。' },
  { q: '育児休業と退職どちらが良いですか？', a: '個別の状況により異なるが一般的です。育児休業給付金等の公的支援を活用する選択肢があるとされています。' },
];
---

<RichLayout {title} {description} {breadcrumb} {faq} {slug}
  publishedDate="2026-06-03" modifiedDate="2026-06-03">

  <section class="fv">
    <div class="fv-pill">妊娠・出産退職 / 公的保護整理</div>
    <h1>妊娠・出産による退職を検討する方へ — 進め方と公開情報整理</h1>
    <p class="lede">本記事では <strong>妊娠・出産による退職向けの判断軸・進め方・公的保護制度</strong> を公開情報をもとに中立に整理します。退職は労働者の権利として保護されており、本人の意思尊重が前提が一般的です。</p>
    <ul class="fv-bullets">
      <li>妊娠・出産退職の基本知識</li>
      <li>労働基準法・関連法令の公的保護</li>
      <li>退職代行サービスの活用検討</li>
      <li>退職後の手続き準備</li>
    </ul>
    <PRBadge pageSlug={slug} />
    <div class="fv-meta">最終更新: 2026年6月3日 | 労働基準法・関連法令準拠 | 効果は個人差あり</div>
  </section>

  <BannerAB pageSlug={slug} position="hero" />

  <section class="lp-section">
    <div class="section-num">SECTION 01</div>
    <h2>妊娠・出産退職の基本</h2>
    <p>妊娠・出産を理由とする退職検討は、男女雇用機会均等法・育児介護休業法等の公的保護を理解した上で進めることが現実的アプローチとされる傾向にあります。男女雇用機会均等法では、妊娠・出産を理由とする解雇・降格・不利益取扱は禁止されており、マタハラ (マタニティハラスメント) も法律で禁じられています。退職を検討する場合、育児休業の活用・産前産後休業の活用・退職等の選択肢を比較検討することが推奨されるのケースが多く見られます。退職代行Jobs は労働組合運営の選択肢で、妊娠・出産関連の退職相談にも対応するのケースが多く見られます。なお、出産後の社会保険・健康保険・出産手当金等の手続きは本人の権利として保護されており、これらを退職前に確認することが推奨されると公表されています。</p>
  </section>

  <BannerAB pageSlug={slug} position="middle" />

  <section class="lp-section">
    <div class="section-num">SECTION 02</div>
    <h2>妊娠・出産退職の進め方</h2>
    <p>妊娠・出産退職の進め方は、公的保護の理解・育児休業/退職の判断・退職後の手続き準備の3点が出発点となります。配偶者との合意形成も併せて推奨されるとされています。</p>
    <ul>
        <li><strong>公的保護の理解</strong>: 男女雇用機会均等法・育児介護休業法等の公的保護を理解しておくことが現実的アプローチと公表されています。</li>
        <li><strong>育児休業/退職の判断</strong>: 育児休業の活用・産前産後休業の活用・退職等の選択肢を比較検討することが推奨されるが一般的です。</li>
        <li><strong>退職後の手続き準備</strong>: 健康保険・社会保険・出産手当金等の手続きを事前確認することが推奨されるのケースが多く見られます。</li>
    </ul>
  </section>

  <section class="lp-section">
    <div class="section-num">SECTION 03</div>
    <h2>公的保護制度の整理</h2>
    <div class="compare-wrap">
      <table class="compare-table">
        <thead><tr><th>制度</th><th>内容</th><th>窓口</th></tr></thead>
        <tbody>
          <tr><td>労働基準法</td><td>退職の自由・有給消化・最終給与等の保護</td><td>労働基準監督署</td></tr>
          <tr><td>民法627条</td><td>退職意思表示から2週間で雇用契約終了</td><td>労働基準監督署</td></tr>
          <tr><td>男女雇用機会均等法</td><td>妊娠・出産を理由とする不利益取扱禁止</td><td>都道府県労働局</td></tr>
          <tr><td>労働組合法</td><td>労働組合運営の退職代行による交渉権</td><td>労働委員会</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <BannerAB pageSlug={slug} position="bottom" />

  <section class="lp-section">
    <div class="section-num">SECTION 04</div>
    <h2>退職代行Jobs (アクセストレード経由) の公開情報整理</h2>
    <p>本サイトが PR として取り上げる「退職代行Jobs」(アクセストレード経由) について、妊娠・出産による退職に関係する公開情報を整理します。</p>
    <ul>
      <li>✅ <strong>労働組合運営</strong>: 合同労組による退職交渉が可能とされる選択肢</li>
      <li>✅ <strong>弁護士監修</strong>: 法的観点での助言が含まれるとされる選択肢</li>
      <li>✅ <strong>24時間対応</strong>: 緊急時の対応が可能とされる選択肢</li>
      <li>✅ <strong>全額返金保証</strong>: 公開情報による表記 (詳細は公式公開情報をご確認ください)</li>
      <li>✅ <strong>後払い対応</strong>: 後払い決済の選択肢があるとされる傾向</li>
    </ul>
  </section>

  <section class="lp-section">
    <div class="section-num">SECTION 05</div>
    <h2>まとめ — 自分の状況に合う選択肢を専門家と相談する</h2>
    <p>
      妊娠・出産による退職は、<strong>公的保護の理解 + 退職代行サービスの活用検討 + 退職後の手続き準備</strong> の3点を整理した上で、自分の状況に合う選択肢を専門家と相談するのが現実的アプローチと示されています。本人の意思尊重が前提とされており、無料相談・公的窓口の活用も選択肢とされます。
    </p>
  </section>

  <BannerAB pageSlug={slug} position="final" />

  <section class="faq-section">
    <h2>よくある質問</h2>
    {faq.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </section>

  <section class="lp-section">
    <h2>参考情報・公開出典</h2>
    <ul class="source-list">
      <li>労働基準法</li>
      <li>民法 (第627条 雇用契約解約)</li>
      <li>男女雇用機会均等法・育児介護休業法</li>
      <li>労働組合法</li>
      <li>厚生労働省「労働相談・窓口」</li>
      <li>国民生活センター「労働トラブル相談事例」</li>
    </ul>
  </section>

</RichLayout>
