  <!-- ★T-M4 [0yAVu8WAXu]: Filter UI JS (vanilla・Astro <script> client side) -->
  <script is:inline>
    (function () {
      const state = {
        type: 'all', // 'all' | 'lawyer' | 'union' | 'private-lawyer,private-union,private'
        line24h: false,
        union: false,
        atobarai: false,
        public: false,
      };

      const typeBtns = document.querySelectorAll('.filter-btn-type');
      const cbLine24h = document.getElementById('filter-line24h');
      const cbUnion = document.getElementById('filter-union');
      const cbAtobarai = document.getElementById('filter-atobarai');
      const cbPublic = document.getElementById('filter-public');
      const rows = document.querySelectorAll('.comparison-row');
      const cards = document.querySelectorAll('.service-card');
      const countEl = document.getElementById('filter-count');
      const emptyEl = document.getElementById('empty-state');

      function matches(el) {
        const type = el.getAttribute('data-type');
        const allowedTypes = state.type === 'all' ? null : state.type.split(',');
        if (allowedTypes && !allowedTypes.includes(type)) return false;
        if (state.line24h && el.getAttribute('data-line24h') !== 'true') return false;
        if (state.union && el.getAttribute('data-union') !== 'true') return false;
        if (state.atobarai && el.getAttribute('data-atobarai') !== 'true') return false;
        if (state.public && el.getAttribute('data-public') !== 'true') return false;
        return true;
      }

      function applyFilter() {
        let visibleCount = 0;
        rows.forEach((r) => {
          const ok = matches(r);
          r.style.display = ok ? '' : 'none';
          if (ok) visibleCount++;
        });
        cards.forEach((c) => {
          c.style.display = matches(c) ? '' : 'none';
        });
        const total = rows.length;
        if (countEl) countEl.textContent = visibleCount + '/' + total + ' 件表示中';
        if (emptyEl) emptyEl.classList.toggle('hidden', visibleCount > 0);
      }

      typeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const t = btn.getAttribute('data-filter-type') || 'all';
          state.type = t;
          typeBtns.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('bg-blue-100', active);
            b.classList.toggle('text-blue-900', active);
            b.classList.toggle('font-semibold', active);
            b.classList.toggle('border-blue-400', active);
            b.classList.toggle('border-gray-300', !active);
            b.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          applyFilter();
        });
      });

      [
        [cbLine24h, 'line24h'],
        [cbUnion, 'union'],
        [cbAtobarai, 'atobarai'],
        [cbPublic, 'public'],
      ].forEach(([el, key]) => {
        if (!el) return;
        el.addEventListener('change', () => {
          state[key] = el.checked;
          applyFilter();
        });
      });

      // 初期表示
      applyFilter();
    })();
  </script>
