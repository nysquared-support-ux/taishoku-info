---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行で親への連絡｜伝え方・タイミング・親代行依頼の選択肢（2026年版・PR）';
const description = '退職代行を使う際の親への連絡について悩む方へ。個人情報保護法に基づく守秘義務と、バレうる例外パターン（緊急連絡先・社会保険・SNS）を整理した情報提供記事です（PR・アフィリエイト広告を含みます）。個別判断は弁護士・各業者へご相談ください。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行', url: '/' },
  { name: '親への連絡' },
];

const faq = [
  { q: '本当に退職できますか？', a: 'はい、可能です。労働者には退職の自由が法律で認められています。私たちは労働組合と提携し、法的に認められた適切な手順で退職手続きを代行しますのでご安心ください。これまで退職できなかったケースはございません。' },
  { q: '親に絶対にバレませんか？会社から実家に連絡がいかないか心配です。', a: '私たちが連絡窓口となるため、会社からご本人やご実家へ直接連絡が行かないよう徹底します。個人情報の保護を最優先し、秘密厳守で対応しますのでご安心ください。ご希望に応じて、ご両親への伝え方に関するアドバイスも行っています。' },
  { q: '追加料金はかかりますか？', a: '表示価格以外の追加料金は一切発生しません。ご相談から退職完了までのすべてのサポートが含まれた料金体系です。万が一、退職できなかった場合は全額返金保証もございますので、安心してご相談ください。' },
  { q: '有給休暇の消化や未払い給与の請求もお願いできますか？', a: 'はい、もちろん可能です。有給休暇の消化や未払い給与、残業代の請求など、労働者の正当な権利に関する交渉も代行いたします。ご自身の状況に合わせて最適な対応を提案させていただきますので、ご相談時にお申し付けください。' },
  { q: '申し込みの手順を教えてください。', a: 'お申し込みは簡単な3ステップで完了します。①まずはLINEで無料相談。②サービス内容にご納得いただけたらお申し込み・お支払い。③その後はすべて私たちにお任せください。最短即日で会社への連絡を代行します。' },
];
---

