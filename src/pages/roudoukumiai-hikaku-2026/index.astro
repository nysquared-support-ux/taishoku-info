---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行の労働組合タイプとは？弁護士・民間との違いと選び方を完全解説2026年版（PR）';
const description = '退職代行の労働組合タイプ（団体交渉権・即日加入・即日対応）の仕組みと5ケース別の使うべき判断基準・弁護士/民間との料金/対応範囲比較・法的根拠を公開情報ベースで整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行', url: '/' },
  { name: '労働組合比較2026' },
];

const faq = [
  { q: '労働組合の退職代行は本当に合法なのですか？', a: 'はい、労働組合による退職代行は、労働組合法で保障された「団体交渉権」を根拠としており、適法な活動とされます。労働者の代理として会社と交渉することは、同法で認められた組合の正当な活動です。ただし、訴訟対応など弁護士のみに許された業務は行えません。' },
  { q: '労働組合に即日加入して、すぐに退職代行を依頼することは可能ですか？', a: '多くの労働組合型退職代行サービスでは、オンラインで加入手続きが完結し、即日での代行依頼が可能な体制を整えています。一般的には、ウェブサイトから申し込み後、担当者との簡単なヒアリングを経て、組合への加入と同時に会社への連絡を開始する流れとなります。' },
  { q: '労働組合の退職代行では、どこまでの交渉が可能ですか？', a: '団体交渉権に基づき、退職の意思伝達、退職日の調整、有給休暇の消化、未払い給与の請求といった交渉が可能です。しかし、会社への損害賠償請求や、交渉が決裂した場合の法廷闘争といった裁判手続きは弁護士の独占業務であり、労働組合では対応できません。' },
  { q: '会社から労働組合への加入を理由に不利益な扱いを受けませんか？', a: '労働組合法第7条では、労働者が労働組合の組合員であることを理由として解雇その他の不利益な取扱いをすることを「不当労働行為」として禁止しています。そのため、組合加入を理由に会社が不利益な扱いをすることは法律で禁じられており、労働者は保護されます。' },
  { q: '弁護士や民間業者と比べ、労働組合を選ぶメリットは何ですか？', a: '最大のメリットは、弁護士に依頼するより費用を抑えつつ、民間業者にはない「団体交渉権」を行使できる点です。これにより、単なる意思伝達に留まらず、有給消化や未払い賃金に関する交渉が法的な後ろ盾をもって可能になります。コストと対応範囲のバランスを重視する場合に適した選択肢と言えるでしょう。' },
];

// ★441-EXT 強化: 労働組合タイプ 3 サービス Service 構造化
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': '退職代行 労働組合タイプ 主要サービス比較',
  'description': '労働組合運営または提携の退職代行サービス 3 件 (公開情報整理)',
  'itemListOrder': 'https://schema.org/ItemListUnordered',
  'itemListElement': [
    {'@type': 'ListItem', 'position': 1, 'item': {'@type': 'Service', 'name': '退職代行Jobs', 'serviceType': '合同労組 + 弁護士監修退職代行', 'description': '料金 ¥27,000・有給/残業代交渉対応・LINE 24h・全額返金保証', 'audience': {'@type': 'Audience', 'audienceType': '有給消化・残業代交渉が必要な正社員/契約社員'}}},
    {'@type': 'ListItem', 'position': 2, 'item': {'@type': 'Service', 'name': '退職代行モームリ', 'serviceType': '労組提携 + 弁護士監修退職代行', 'description': '料金 ¥22,000 (正社員) / ¥12,000 (パート/アルバイト)・最安帯', 'audience': {'@type': 'Audience', 'audienceType': '料金重視・基本的な退職通知が必要なユーザー'}}},
    {'@type': 'ListItem', 'position': 3, 'item': {'@type': 'Service', 'name': '退職代行ニコイチ', 'serviceType': '民間 + 弁護士監修退職代行', 'description': '料金 ¥27,000・創業 18 年実績豊富 (民間タイプだが比較対象)', 'audience': {'@type': 'Audience', 'audienceType': 'シンプル退職を希望するユーザー'}}},
  ],
};
