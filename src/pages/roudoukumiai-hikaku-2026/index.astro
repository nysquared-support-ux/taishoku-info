<RichLayout title={title} description={description} publishedDate="2026-05-12" modifiedDate="2026-05-18" breadcrumb={breadcrumb} faq={faq}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  <section class="fv" aria-labelledby="fv-h1">
