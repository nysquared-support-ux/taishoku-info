            <tr><td><b>退職代行モームリ</b></td><td>労組提携 + 弁護士監修</td><td>¥22,000 (正社員)</td><td>最安帯・パート/アルバイト ¥12,000</td></tr>
            <tr><td><b>退職代行ニコイチ</b></td><td>民間 + 弁護士監修</td><td>¥27,000</td><td>創業 18 年実績 (民間タイプ・比較対象)</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-faq">
    <div class="container">
      <p class="section-num">SECTION / 06</p>
      <h2>よくある質問（FAQ）</h2>
      <div class="faq">
