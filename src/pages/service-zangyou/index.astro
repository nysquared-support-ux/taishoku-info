---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = 'サービス残業の退職代行｜未払い残業代回収と退職を両立する業者選び5軸（2026年版・PR）';
const description = 'サービス残業 (未払い残業代) が常態化している職場から退職する際の、未払い残業代回収と退職代行活用5軸を整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'サービス残業の退職' },
];

const faq = [
  { q: '退職代行を使っても、本当に未払いのサービス残業代を請求できますか？', a: '弁護士が運営する退職代行サービスであれば、退職の意思伝達に加えて未払い残業代の請求交渉も可能です。労働基準法第37条では時間外労働に対する割増賃金の支払いが定められており、これに基づき請求が行われます。非弁護士の業者は交渉ができないため、業者選びが重要とされます。' },
  { q: '未払い残業代を請求するには、どのような証拠が必要になりますか？', a: 'タイムカード、業務日報、PCのログイン記録、業務用メールの送受信履歴などが客観的な証拠として有効とされます。証拠が少ない場合でも、弁護士に相談することで会社への開示請求といった手段を検討できる可能性があります。まずは手元にあるものを整理することが推奨されます。' },
  { q: 'サービス残業代の請求に時効はありますか？', a: 'はい、賃金請求権には時効が存在します。労働基準法の改正により、2020年4月1日以降に支払期日が到来する賃金については、当面の間、時効期間が3年とされています。時効が成立する前に内容証明郵便の送付など、法的な手続きに着手することが重要です。' },
  { q: '会社から「残業代は支払わないと合意した」と言われたらどうなりますか？', a: '労働者と使用者の間で残業代を支払わないという合意があったとしても、それが労働基準法で定められた基準を下回る場合、その合意は無効とされる可能性が高いです。同法は強行法規とされ、当事者の合意よりも優先されるためです。個別の状況は専門家への相談が望ましいでしょう。' },
  { q: '退職代行で残業代請求も依頼する場合、どのような業者を選べば良いですか？', a: '未払い残業代の請求交渉は弁護士法で定められた法律事務にあたるため、弁護士または弁護士法人が運営する退職代行サービスを選ぶ必要があります。労働組合も団体交渉権を持ちますが、交渉の範囲や方法が異なるため、ご自身の希望に応じて比較検討することが推奨されます。' },
];
---

<RichLayout title={title} description={description} publishedDate="2026-05-20" modifiedDate="2026-05-20" breadcrumb={breadcrumb} faq={faq}>
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">退職代行 / サービス残業</span>
      <h1 id="fv-h1"><span class="accent">サービス残業の退職代行</span><br />未払い残業代回収と退職を両立する業者選び5軸</h1>
      <p class="lede">サービス残業 (未払い残業代) が常態化した職場からの退職は「未払い残業代の請求権 (3年以内)」「証拠確保」「弁護士運営による法的交渉」を踏まえた計画判断が推奨されます。本記事では公開情報・公的機関データをもとに、未払い残業代回収と退職を両立する5軸を中立的に整理します。</p>
      <ul class="fv-bullets">
        <li>未払い残業代請求権 (退職後3年以内・労基法115条)</li>
        <li>証拠確保 (タイムカード以外の補完証拠)</li>
        <li>みなし残業 (固定残業代) との関係</li>
        <li>未払い残業代交渉対応の業者選び5軸</li>
      </ul>
      <PRBadge pageSlug="service-zangyou" />
      <div class="fv-meta">
        <span><b>公開日</b> 2026-05-20</span><span><b>最終更新</b> 2026-05-20</span>
        <span><b>編集</b> NY-squared 編集部</span><span><b>所要</b> 約 6 分</span>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-1" aria-labelledby="h2-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2 id="h2-1">サービス残業退職の前提整理 (5 ポイント)</h2>
      <p class="section-lede">公開情報・厚生労働省公開資料の整理として、サービス残業退職検討で押さえておくべき前提を 5 ポイントに整理します。</p>
      <ol>
        <li><strong>未払い残業代請求権</strong>: 労基法115条で退職後 3 年以内に請求可能 (2020年改正で延長)</li>
        <li><strong>割増賃金</strong>: 労基法37条で時間外 25%増・休日 35%増・深夜 25%増が義務</li>
        <li><strong>サービス残業は違法</strong>: 法定労働時間を超える労働の対価未払いは労基法違反</li>
        <li><strong>証拠の重要性</strong>: タイムカード・メール・PC ログ・スマホ位置情報等の補完証拠</li>
        <li><strong>みなし残業の例外</strong>: 固定残業代制でも超過分は別途請求可能</li>
      </ol>
      <BannerAB pageSlug="service-zangyou" position="hero" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2>サービス残業退職時の業者選び 5 軸</h2>
      <div class="card-grid">
        <div class="card"><h3>① 未払い残業代交渉</h3><p>弁護士運営が法的交渉・訴訟対応可。労組運営は団体交渉として対応可能とされます。</p></div>
        <div class="card"><h3>② 即日意思伝達</h3><p>サービス残業常態化職場からの即時離脱を即日対応可能な業者が選択肢として整理されます。</p></div>
        <div class="card"><h3>③ 証拠整理サポート</h3><p>請求の根拠となる証拠 (補完証拠含む) の整理アドバイスがあるか確認します。</p></div>
        <div class="card"><h3>④ 料金透明性</h3><p>追加費用・成功報酬の有無を事前確認。回収可能額との費用対効果を計算します。</p></div>
        <div class="card"><h3>⑤ 労基署対応サポート</h3><p>必要に応じて労基署への通報手続きをサポートする業者経験も選択軸とされます。</p></div>
      </div>
    </div>
  </section>

  <section class="lp-section"><h2>サービス残業と退職代行の基本｜未払い賃金請求の法的根拠</h2><p>サービス残業（未払い残業）が常態化している職場からの退職は、精神的な負担が大きいものです。<br><br>退職の意思を伝えにくい状況で、さらに未払い残業代の請求まで個人で行うのは困難を極めます。<br><br>こうした状況で活用が検討されるのが、退職代行サービスです。<br><br>そもそもサービス残業は、労働基準法第37条で定められた割増賃金の支払義務に違反する行為とされます。<br><br>使用者は、法定労働時間を超えて労働させた場合、法律で定められた割増率以上の賃金を支払わなければなりません。<br><br>退職代行サービスにはいくつかの運営形態がありますが、未払い残業代の請求（交渉）までを依頼したい場合、弁護士が運営するサービスを選択する必要があります。<br><br>弁護士法に基づき、弁護士以外の者が報酬を得る目的で法律事務を行うこと（非弁行為）は禁止されているためです。<br><br>まずはご自身の状況を整理し、退職の意思伝達だけで良いのか、未払い賃金の請求まで行いたいのかを明確にすることが、適切な業者選びの第一歩となります。<br><br>厚生労働省の総合労働相談コーナーなどでも、労働問題に関する一般的な情報提供が行われています。</p></section>

  <section class="lp-section alt" id="sec-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2>サービス残業退職の進め方 (3 ステップ)</h2>
      <p class="section-lede">公開情報・厚労省公開資料の整理として、サービス残業退職を計画的に進めるステップを 3 つに整理します。</p>
      <div class="counter-box">
        <h3>📌 計画的に進める 3 ステップ</h3>
        <div class="row"><b>STEP 1. 証拠の確保 (退職表明 1 ヶ月前 〜)</b><span>タイムカード・PC ログ・メール時刻・スマホ位置情報・給与明細を退職前に確保。スマホ撮影・自宅メール転送が一般的とされる。</span></div>
        <div class="row"><b>STEP 2. 業者選定 (退職表明 1-2 週間前)</b><span>未払い残業代額・即日対応・証拠整理サポートの 3 軸で 2-3 社に絞込。無料相談 (LINE/電話) で対応可否を確認。</span></div>
        <div class="row"><b>STEP 3. 依頼実行 (平日午前中)</b><span>平日午前中の依頼が即日成立確率を高めるとされる。詳細は <a href="/touji/">即日・当日対応ページ</a> 参照。未払い残業代請求も依頼時に明示。</span></div>
        <p style="margin-top:12px;font-size:13px;color:var(--c-text-sub,#4a5568);">※公開情報・厚労省公開資料の整理 (推定値含む)・個別案件は弁護士・各業者へご相談ください。</p>
      </div>
    </div>
  </section>

  <section class="lp-section"><h2>未払い残業代回収と退職を両立する具体的な手順と注意点</h2><p>退職代行を利用して未払い残業代を回収する場合、計画的な準備が成功の鍵となります。<br><br>以下に、公開情報をもとに一般的な手順と注意点を整理します。<br><br>まず最も重要なのが「証拠の収集」です。<br><br>タイムカードのコピー、給与明細、PCのログ、業務メール、手帳の記録など、客観的に労働時間を証明できる資料を可能な限り集めます。<br><br>これらの証拠が、後の交渉や法的手続きにおいて極めて重要になります。<br><br>消費者庁も、トラブルに備えて契約内容や事業者とのやり取りの記録を残すことを推奨しています。<br><br>次に、弁護士が運営する退職代行サービスに相談します。<br><br>複数の業者に相談し、費用体系や実績、担当者との相性を比較検討することが望ましいです。<br><br>相談時には、収集した証拠を提示し、回収可能性や見込み額について見解を求めます。<br><br>正式に依頼すると、弁護士が代理人として会社に退職の意思を通知し、同時に未払い残業代の請求交渉を開始します。<br><br>交渉がまとまれば合意書を取り交わし、指定の期日までに残業代が支払われる流れが一般的です。<br><br>交渉が不調に終わった場合は、労働審判や訴訟といった法的手続きに移行することも視野に入れます。</p><ul><li><strong>証拠収集:</strong> タイムカード、給与明細、業務日報、PCログなど客観的な記録を在職中に確保する。</li><li><strong>専門家への相談:</strong> 弁護士法人が運営する退職代行サービスに相談し、費用や方針を確認する。</li><li><strong>交渉と手続き:</strong> 弁護士を通じて会社と交渉。合意に至らない場合は労働審判等も検討する。</li></ul><div class="benefit-summary" style="background:#f5f5dc;padding:1rem;border-left:4px solid #d4a373;margin:1rem 0;"><strong>💡 このサービスを検討するメリット (★544 ②):</strong><ul><li><strong>時間と精神的負担の軽減:</strong> 煩雑な交渉や手続きを専門家に一任でき、会社と直接やり取りするストレスから解放される可能性が期待されます。</li><li><strong>回収額の適正化が期待できる:</strong> 労働法の専門家が法的根拠に基づき交渉するため、個人で請求するよりも適正な金額を回収できる可能性が高まります。</li><li><strong>円満かつ迅速な退職の実現:</strong> 未払い賃金の請求と退職手続きを並行して進めることで、問題を一括で解決し、スムーズに次のステップへ進むことが期待されます。</li></ul></div></section>

  <section class="lp-section alt" id="sec-summary">
    <div class="container">
      <p class="section-num">SECTION / 06</p>
      <h2>まとめ</h2>
      <p>サービス残業 (未払い残業代) 常態化職場からの退職は ①証拠の確保 (退職前) ②業者選定 (未払い額に応じて弁護士運営/労組運営) ③依頼実行+未払い残業代請求並行・の 3 ステップが基本軸とされます。<br><br>請求権の時効は退職後 3 年 (労基法115条) とされ、早期の対応が重要とされます。<br><br>未払い残業代が高額な場合は弁護士運営の退職代行で法的交渉と退職を並行するパターンが、公開情報で整理されている計画的な進め方の一例とされます。</p>
      <p><strong>状況別の推奨形態</strong>: ① <strong>未払い残業代高額 (50万円超目安)</strong> → 弁護士運営 ② <strong>未払い額中程度・即日重視</strong> → 労組運営 (団体交渉対応) ③ <strong>意思伝達のみ + 労基署通報並行</strong> → 民間運営 + 労基署。</p>
      <p style="font-size:13px;color:var(--c-text-mute,#6b7280);">※残業代は <a href="/zangyodai/">残業代ページ</a> ・給与未払いは <a href="/kyuyo-mibarai/">給与未払い退職ページ</a> ・5 社比較は <a href="/osusume-hikaku/">おすすめ比較</a> もあわせてご参照ください。本記事は法的助言ではなく、特定業者を推奨するものでもありません。</p>
      <PRBadge pageSlug="service-zangyou" label="退職代行サービスの公式サイトで無料相談する（PR）" />
    </div>
  </section>

  <section class="lp-section" id="sec-policy">
    <div class="container">
      <p class="section-num">SECTION / 07</p>
      <h2>編集ポリシー (情報源・更新日・E-E-A-T)</h2>
      <ul>
        <li><strong>情報源</strong>: 政府公式 e-Gov 法令検索 (民法・労基法) ・厚生労働省公式サイト ・各退職代行業者公式サイト</li>
        <li><strong>編集方針</strong>: 一次情報優先 (法令は e-Gov 直接リンク) ・断定表現を避け推定値・公開情報の整理として記述</li>
        <li><strong>運営者</strong>: NY-squared (個人事業) <a href="/operator-info/">運営情報ページ</a> 参照</li>
        <li><strong>E-E-A-T 4 原則</strong>: Experience (退職代行・残業代の公開情報整理) ・Expertise (法令引用) ・Authoritativeness (政府公式 + 業者公式の一次情報のみ) ・Trustworthiness (PR 表記 + 推定値明示 + 法的助言ではない注記)</li>
      </ul>

      <h2>出典・参考情報 (法令・公的機関・公開情報)</h2>
      <ul>
        <li><a href="https://www.mhlw.go.jp/" target="_blank" rel="noopener">厚生労働省</a> (労働基準監督署・労働相談窓口)</li>
        <li><a href="https://www.houterasu.or.jp/" target="_blank" rel="noopener">法テラス</a> (法律相談窓口)</li>
        <li><a href="https://elaws.e-gov.go.jp/document?lawid=129AC0000000089" target="_blank" rel="noopener">民法第627条 (退職の権利・e-Gov)</a></li>
        <li><a href="https://elaws.e-gov.go.jp/document?lawid=322AC0000000049" target="_blank" rel="noopener">労働基準法第37条/115条 (e-Gov)</a></li>
        <li>各退職代行業者公式サイト・最新情報は各公式サイトでご確認ください</li>
      </ul>
      <p style="font-size:12px;color:var(--c-text-mute,#6b7280);margin-top:16px;">
        ※本記事は2026年5月時点の公開情報をもとに作成。最新の法令・サービス内容は各公式サイトでご確認ください。本ページはアフィリエイト広告（PR）を含みます。
      </p>
    </div>
  </section>

  <section class="lp-section alt" id="sec-asp-pr" aria-labelledby="h2-asp-pr">
    <div class="container">
      <p class="section-num">SECTION / PR・広告</p>
      <h2 id="h2-asp-pr">【PR・広告】退職代行Jobs (株式会社アレス) の公開情報整理</h2>
      <p class="section-lede"><strong>本セクションは PR・広告枠</strong> です。アフィリエイト広告として「退職代行Jobs (株式会社アレス)」の公開情報を整理しています。他事業者との優劣判断ではなく、広告主の公開情報として参照ください。</p>
      <div class="branch-grid">
      <article class="branch"><span class="tag">特徴①</span><h4>退職代行Jobs</h4><p>退職代行Jobs (株式会社アレス運営) は退職代行サービスの一つとされる傾向。会社との連絡を代行する選択肢として検討対象とされています。</p></article>
      <article class="branch"><span class="tag">特徴②</span><h4>LINE相談対応</h4><p>LINE での相談対応の傾向。気軽に相談できる選択肢とされる傾向。</p></article>
      <article class="branch"><span class="tag">特徴③</span><h4>顧問弁護士監修</h4><p>顧問弁護士監修の傾向。法的トラブル懸念のある方の検討材料が一般的です。</p></article>
      <article class="branch"><span class="tag">特徴④</span><h4>全国対応</h4><p>全国対応の傾向。地方在住者も利用可能な選択肢のケースが多く見られます。</p></article>
      <article class="branch"><span class="tag">特徴⑤</span><h4>プライバシー配慮</h4><p>個人情報保護法遵守の傾向。会社・家族にバレにくい配慮があると公表されています。</p></article>
      <article class="branch"><span class="tag">注意</span><h4>事前確認推奨事項</h4><p>具体的料金・対応範囲・成功事例は公式公開情報で確認推奨。「100%退職成功」等の断定は不可とされています。</p></article>
      </div>
      <div class="cta-block"><p class="cta-note"><span class="pr-tag">PR</span>退職代行Jobs (株式会社アレス) の最新の条件は公式サイトでご確認ください。</p><BannerAB pageSlug={"enhance-cta"} position="enhance" /><p class="btn-cta-sub">※ 公式サイトに遷移します。</p></div>
    </div>
  </section>

  <section class="lp-section" id="sec-koteki-laws" aria-labelledby="h2-koteki-laws">
    <div class="container">
      <p class="section-num">SECTION / 公的窓口・関連法令</p>
      <h2 id="h2-koteki-laws">公的窓口・関連法令</h2>
      <p class="section-lede">トラブル時・疑問時は公的窓口の活用が推奨されます。</p>
