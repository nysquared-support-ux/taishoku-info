---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = 'サービス残業の退職代行｜未払い残業代回収と退職を両立する業者選び5軸（2026年版・PR）';
const description = 'サービス残業 (未払い残業代) が常態化している職場から退職する際の、未払い残業代回収と退職代行活用5軸を整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: 'サービス残業の退職' },
];

const faq = [
  { q: 'サービス残業の残業代は退職後に請求できる？', a: '一般に未払い残業代の請求権の消滅時効は退職後 3 年とされ (労基法第115条・2020年改正)、退職後でも請求可能とされます。' },
  { q: 'タイムカードがない・改ざんされていた場合は？', a: '一般にメール送受信時刻・PC ログイン記録・スマホ位置情報等が補完証拠として整理されることがあります。弁護士相談で証拠の整理が可能とされます。' },
  { q: 'みなし残業 (固定残業代) でも未払い請求できる？', a: '一般にみなし時間を超える残業分は別途請求可能とされます。雇用契約書のみなし時間の明示と実労働時間の比較が判断材料とされます。' },
];
---

<RichLayout title={title} description={description} publishedDate="2026-05-20" modifiedDate="2026-05-20" breadcrumb={breadcrumb} faq={faq}>
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">退職代行 / サービス残業</span>
      <h1 id="fv-h1"><span class="accent">サービス残業の退職代行</span><br />未払い残業代回収と退職を両立する業者選び5軸</h1>
      <p class="lede">サービス残業 (未払い残業代) が常態化した職場からの退職は「未払い残業代の請求権 (3年以内)」「証拠確保」「弁護士運営による法的交渉」を踏まえた計画判断が推奨されます。本記事では公開情報・公的機関データをもとに、未払い残業代回収と退職を両立する5軸を中立的に整理します。</p>
      <ul class="fv-bullets">
        <li>未払い残業代請求権 (退職後3年以内・労基法115条)</li>
        <li>証拠確保 (タイムカード以外の補完証拠)</li>
        <li>みなし残業 (固定残業代) との関係</li>
        <li>未払い残業代交渉対応の業者選び5軸</li>
      </ul>
      <PRBadge pageSlug="service-zangyou" />
      <div class="fv-meta">
        <span><b>公開日</b> 2026-05-20</span><span><b>最終更新</b> 2026-05-20</span>
        <span><b>編集</b> NY-squared 編集部</span><span><b>所要</b> 約 6 分</span>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-1" aria-labelledby="h2-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2 id="h2-1">サービス残業退職の前提整理 (5 ポイント)</h2>
      <p class="section-lede">公開情報・厚生労働省公開資料の整理として、サービス残業退職検討で押さえておくべき前提を 5 ポイントに整理します。</p>
      <ol>
        <li><strong>未払い残業代請求権</strong>: 労基法115条で退職後 3 年以内に請求可能 (2020年改正で延長)</li>
        <li><strong>割増賃金</strong>: 労基法37条で時間外 25%増・休日 35%増・深夜 25%増が義務</li>
        <li><strong>サービス残業は違法</strong>: 法定労働時間を超える労働の対価未払いは労基法違反</li>
        <li><strong>証拠の重要性</strong>: タイムカード・メール・PC ログ・スマホ位置情報等の補完証拠</li>
        <li><strong>みなし残業の例外</strong>: 固定残業代制でも超過分は別途請求可能</li>
      </ol>
      <BannerAB pageSlug="service-zangyou" position="hero" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2>サービス残業退職時の業者選び 5 軸</h2>
      <div class="card-grid">
        <div class="card"><h3>① 未払い残業代交渉</h3><p>弁護士運営が法的交渉・訴訟対応可。労組運営は団体交渉として対応可能とされます。</p></div>
        <div class="card"><h3>② 即日意思伝達</h3><p>サービス残業常態化職場からの即時離脱を即日対応可能な業者が選択肢として整理されます。</p></div>
        <div class="card"><h3>③ 証拠整理サポート</h3><p>請求の根拠となる証拠 (補完証拠含む) の整理アドバイスがあるか確認します。</p></div>
        <div class="card"><h3>④ 料金透明性</h3><p>追加費用・成功報酬の有無を事前確認。回収可能額との費用対効果を計算します。</p></div>
        <div class="card"><h3>⑤ 労基署対応サポート</h3><p>必要に応じて労基署への通報手続きをサポートする業者経験も選択軸とされます。</p></div>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-3">
    <div class="container">
      <p class="section-num">SECTION / 03</p>
      <h2>業者形態別の比較 (サービス残業退職軸)</h2>
      <p class="compare-note">※公開情報の整理 (推定値含む)・データ更新日: 2026-05-20・最新情報は各公式サイトで必ずご確認ください</p>
      <div class="compare-wrap">
        <table class="compare">
          <thead>
            <tr><th>運営形態</th><th>残業代交渉</th><th>料金 (推定)</th><th>即日対応</th><th>労基署対応</th><th>サービス残業退職向き</th></tr>
          </thead>
          <tbody>
            <tr><td><b>弁護士運営</b></td><td>法的交渉・訴訟対応可</td><td>5万円〜 (推定) + 成功報酬</td><td>◯</td><td>◯</td><td>高 (回収重視)</td></tr>
            <tr><td><b>労働組合運営</b></td><td>団体交渉権 (賃金・退職日)</td><td>2.5〜3万円</td><td>◯</td><td>△</td><td>高 (額が大きくない場合)</td></tr>
            <tr><td><b>民間運営 (弁護士監修)</b></td><td>意思伝達のみ</td><td>2〜2.5万円</td><td>◯</td><td>×</td><td>低 (残業代回収不可)</td></tr>
            <tr><td><b>民間運営 (監修なし)</b></td><td>意思伝達のみ・非弁行為リスク</td><td>1〜2万円</td><td>△</td><td>×</td><td>低 (リスク高)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="section-lede">サービス残業退職では <strong>未払い残業代の規模</strong> で選定軸が変わります。高額 (50万円超目安) → 弁護士運営、額が小さい・即日重視 → 労組運営。詳細な業者比較は <a href="/osusume-hikaku/">退職代行 おすすめ比較</a> ページを参照ください。</p>
      <BannerAB pageSlug="service-zangyou" position="middle" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2>サービス残業退職の進め方 (3 ステップ)</h2>
      <p class="section-lede">公開情報・厚労省公開資料の整理として、サービス残業退職を計画的に進めるステップを 3 つに整理します。</p>
      <div class="counter-box">
        <h3>📌 計画的に進める 3 ステップ</h3>
        <div class="row"><b>STEP 1. 証拠の確保 (退職表明 1 ヶ月前 〜)</b><span>タイムカード・PC ログ・メール時刻・スマホ位置情報・給与明細を退職前に確保。スマホ撮影・自宅メール転送が一般的とされる。</span></div>
        <div class="row"><b>STEP 2. 業者選定 (退職表明 1-2 週間前)</b><span>未払い残業代額・即日対応・証拠整理サポートの 3 軸で 2-3 社に絞込。無料相談 (LINE/電話) で対応可否を確認。</span></div>
        <div class="row"><b>STEP 3. 依頼実行 (平日午前中)</b><span>平日午前中の依頼が即日成立確率を高めるとされる。詳細は <a href="/touji/">即日・当日対応ページ</a> 参照。未払い残業代請求も依頼時に明示。</span></div>
        <p style="margin-top:12px;font-size:13px;color:var(--c-text-sub,#4a5568);">※公開情報・厚労省公開資料の整理 (推定値含む)・個別案件は弁護士・各業者へご相談ください。</p>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-faq">
    <div class="container">
      <p class="section-num">SECTION / 05</p>
      <h2>よくある質問（FAQ）</h2>
      <div class="faq">
        <details><summary>Q1. 持ち帰り残業・自宅残業も未払い請求できる？</summary><div><p>一般に使用者の指揮命令下にある労働時間は労働時間とされ、自宅作業も対象になり得るとされます。PC ログ・メール送受信時刻・チャット送信記録等が証拠となるケースがあるとされます。</p></div></details>
        <details><summary>Q2. みなし残業 (固定残業代) で残業代未払いと言える？</summary><div><p>一般にみなし残業代の対象時間を超える残業分は別途請求可能とされます。雇用契約書のみなし時間と実労働時間の差を整理することが推奨されます。</p></div></details>
        <details><summary>Q3. 管理職 (管理監督者) はサービス残業未払い請求できない？</summary><div><p>一般に「管理監督者」 (労基法41条) は時間外・休日割増の例外対象ですが、深夜割増は適用されるとされます。また「名ばかり管理職」は管理監督者と認められず、未払い請求が可能なケースがあるとされます。</p></div></details>
        <details><summary>Q4. 残業代未払いの請求時効はいつから？</summary><div><p>一般に各賃金支払日から請求権発生とされ、退職後 3 年で消滅時効 (労基法115条) とされます。早期の請求準備が推奨されます。</p></div></details>
        <details><summary>Q5. サービス残業退職を労基署に通報するメリットは？</summary><div><p>一般に労基署の是正勧告で会社の自発的支払いを促す効果があるとされます。ただし強制回収権限はなく、確実な回収には弁護士による法的請求が必要とされます。労基署通報と弁護士相談の併用が一般的な選択肢として整理されています。</p></div></details>
      </div>
    </div>
  </section>

  <section class="lp-section alt" id="sec-summary">
    <div class="container">
      <p class="section-num">SECTION / 06</p>
      <h2>まとめ</h2>
      <p>サービス残業 (未払い残業代) 常態化職場からの退職は ①証拠の確保 (退職前) ②業者選定 (未払い額に応じて弁護士運営/労組運営) ③依頼実行+未払い残業代請求並行・の 3 ステップが基本軸とされます。請求権の時効は退職後 3 年 (労基法115条) とされ、早期の対応が重要とされます。未払い残業代が高額な場合は弁護士運営の退職代行で法的交渉と退職を並行するパターンが、公開情報で整理されている計画的な進め方の一例とされます。</p>
      <p><strong>状況別の推奨形態</strong>: ① <strong>未払い残業代高額 (50万円超目安)</strong> → 弁護士運営 ② <strong>未払い額中程度・即日重視</strong> → 労組運営 (団体交渉対応) ③ <strong>意思伝達のみ + 労基署通報並行</strong> → 民間運営 + 労基署。</p>
      <p style="font-size:13px;color:var(--c-text-mute,#6b7280);">※残業代は <a href="/zangyodai/">残業代ページ</a> ・給与未払いは <a href="/kyuyo-mibarai/">給与未払い退職ページ</a> ・5 社比較は <a href="/osusume-hikaku/">おすすめ比較</a> もあわせてご参照ください。本記事は法的助言ではなく、特定業者を推奨するものでもありません。</p>
      <PRBadge pageSlug="service-zangyou" label="退職代行サービスの公式サイトで無料相談する（PR）" />
    </div>
  </section>

  <section class="lp-section" id="sec-policy">
    <div class="container">
      <p class="section-num">SECTION / 07</p>
      <h2>編集ポリシー (情報源・更新日・E-E-A-T)</h2>
      <ul>
        <li><strong>情報源</strong>: 政府公式 e-Gov 法令検索 (民法・労基法) ・厚生労働省公式サイト ・各退職代行業者公式サイト</li>
        <li><strong>編集方針</strong>: 一次情報優先 (法令は e-Gov 直接リンク) ・断定表現を避け推定値・公開情報の整理として記述</li>
        <li><strong>運営者</strong>: NY-squared (個人事業) <a href="/operator-info/">運営情報ページ</a> 参照</li>
        <li><strong>E-E-A-T 4 原則</strong>: Experience (退職代行・残業代の公開情報整理) ・Expertise (法令引用) ・Authoritativeness (政府公式 + 業者公式の一次情報のみ) ・Trustworthiness (PR 表記 + 推定値明示 + 法的助言ではない注記)</li>
      </ul>

      <h2>出典・参考情報 (法令・公的機関・公開情報)</h2>
      <ul>
        <li><a href="https://www.mhlw.go.jp/" target="_blank" rel="noopener">厚生労働省</a> (労働基準監督署・労働相談窓口)</li>
        <li><a href="https://www.houterasu.or.jp/" target="_blank" rel="noopener">法テラス</a> (法律相談窓口)</li>
        <li><a href="https://elaws.e-gov.go.jp/document?lawid=129AC0000000089" target="_blank" rel="noopener">民法第627条 (退職の権利・e-Gov)</a></li>
        <li><a href="https://elaws.e-gov.go.jp/document?lawid=322AC0000000049" target="_blank" rel="noopener">労働基準法第37条/115条 (e-Gov)</a></li>
        <li>各退職代行業者公式サイト・最新情報は各公式サイトでご確認ください</li>
      </ul>
      <p style="font-size:12px;color:var(--c-text-mute,#6b7280);margin-top:16px;">
        ※本記事は2026年5月時点の公開情報をもとに作成。最新の法令・サービス内容は各公式サイトでご確認ください。本ページはアフィリエイト広告（PR）を含みます。
      </p>
    </div>
  </section>
</RichLayout>
