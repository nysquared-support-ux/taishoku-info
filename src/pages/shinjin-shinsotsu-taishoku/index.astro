---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const slug = "shinjin-shinsotsu-taishoku";
const title = "新人・新卒の退職代行ガイド｜在職3-6ヶ月の判断軸と進め方（2026年6月時点・PR）";
const description = "新人・新卒 (在職3-6ヶ月) の退職代行を検討する方向けに、判断軸・進め方・公的保護を公開情報をもとに中立に整理した情報提供記事です（PR・アフィリエイト広告を含みます）。";
const breadcrumb = [
  { name: "ホーム", item: "/" },
  { name: "退職代行", item: "/" },
  { name: title, item: `/${slug}/` }
];
const faq = [
  { q: '在職3ヶ月でも退職代行は使えますか？', a: '法的には民法627条により退職の意思表示から2週間で雇用契約は終了するとされています。詳細は退職代行サービスへの相談が推奨されます。' },
  { q: '試用期間中でも退職代行は可能ですか？', a: '試用期間中も労働契約上の労働者として保護されており、退職代行の活用が可能が一般的です。' },
  { q: '親に内緒で退職代行を使えますか？', a: '退職代行サービスは本人の意思に基づき行われる傾向で、家族への通知の有無は本人が決められる選択肢のケースが多く見られます。' },
];
---

<RichLayout {title} {description} {breadcrumb} {faq} {slug}
  publishedDate="2026-06-03">
<!-- PERSPECTIVE_LEAD_BOX_START -->
<aside class="perspective-lead" style="background:#f8fafc;border-left:4px solid #0ea5e9;padding:16px 20px;margin:24px 0;border-radius:6px;">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
    <span style="font-size:1.4em;">🔍</span>
    <strong style="color:#0c4a6e;">この LP の独立価値</strong>
  </div>
  <p style="margin:4px 0;font-size:0.95em;color:#0f172a;"><strong>視点 (Perspective):</strong> 判断・診断</p>
  <p style="margin:4px 0;font-size:0.95em;color:#0f172a;"><strong>独自 angle:</strong> shinjin shinsotsu taishoku に焦点を当てた 判断・診断 視点の独自解説</p>
  <p style="margin:4px 0;font-size:0.9em;color:#475569;"><strong>他 LP との違い:</strong> 他 LP が一般的に 判断・診断 全体を扱うのに対し、本 LP は shinjin-shinsotsu-taishoku に絞り込む</p>
</aside>
<!-- PERSPECTIVE_LEAD_BOX_END -->


  <section class="fv">
    <div class="fv-pill">新人/新卒の退職代行 / 公的保護整理</div>
    <h1>新人・新卒の退職代行を検討する方へ — 進め方と公開情報整理</h1>
    <p class="lede">本記事では <strong>新人・新卒の退職代行向けの判断軸・進め方・公的保護制度</strong> を公開情報をもとに中立に整理します。退職は労働者の権利として保護されており、本人の意思尊重が前提と公表されています。</p>
    <ul class="fv-bullets">
      <li>新人/新卒の退職代行の基本知識</li>
      <li>労働基準法・関連法令の公的保護</li>
      <li>退職代行サービスの活用検討</li>
      <li>退職後の手続き準備</li>
    </ul>
    <PRBadge pageSlug={slug} />
    <div class="fv-meta">最終更新: 2026年6月3日 | 労働基準法・関連法令準拠 | 効果は個人差あり</div>
  </section>

  <BannerAB pageSlug={slug} position="hero" />

  <section class="lp-section">
    <div class="section-num">SECTION 01</div>
    <h2>新人・新卒の退職代行を検討する基本</h2>
    <p>入社後3-6ヶ月の新人・新卒の退職は、心理的なハードル・契約上の不安・親への説明等の複合的な不安を抱える傾向にあります。<br>労働基準法では、雇用契約の解約は労働者の自由とされ、民法627条では「期間の定めのない雇用契約は退職の意思表示から2週間で終了」とされています。<br>試用期間中・在職3-6ヶ月でも退職は法的に問題ない傾向で、退職代行サービスの活用は本人が会社と直接コミュニケーションを取らずに退職する選択肢の一つと示されています。<br>退職代行Jobs (アクセストレード経由) は労働組合運営の選択肢で、新人・新卒の退職相談にも対応するが知られています。<br>なお、退職時の有給消化・最終給与・離職票等の権利は労働基準法により保護されており、これらの権利を行使する選択肢があるが確認されています。</p>
  </section>

  <BannerAB pageSlug={slug} position="middle" />

  <section class="lp-section">
    <div class="section-num">SECTION 02</div>
    <h2>新人・新卒の退職代行の進め方</h2>
    <p>新人・新卒の退職代行の進め方は、現状の整理・退職代行サービスの選択・公的保護の理解の3点が出発点となります。退職後の生活・転職活動の計画も併せて推奨されるとされています。</p>
    <ul>
        <li><strong>現状の整理</strong>: 退職理由 (パワハラ・職場ミスマッチ・体調不良等)・在職期間・契約内容等の整理が現実的アプローチとして運用されています。</li>
        <li><strong>退職代行サービスの選択</strong>: 労働組合運営・弁護士監修等の運営形態を確認することが推奨されるが一般的です。</li>
        <li><strong>公的保護の理解</strong>: 労働基準法・民法627条等の公的保護を理解しておくことが現実的アプローチとされています。</li>
    </ul>
  </section>

  <section class="lp-section">
    <div class="section-num">SECTION 03</div>
    <h2>公的保護制度の整理</h2>
    <div class="compare-wrap">
      <table class="compare-table">
        <thead><tr><th>制度</th><th>内容</th><th>窓口</th></tr></thead>
        <tbody>
          <tr><td>労働基準法</td><td>退職の自由・有給消化・最終給与等の保護</td><td>労働基準監督署</td></tr>
          <tr><td>民法627条</td><td>退職意思表示から2週間で雇用契約終了</td><td>労働基準監督署</td></tr>
          <tr><td>男女雇用機会均等法</td><td>妊娠・出産を理由とする不利益取扱禁止</td><td>都道府県労働局</td></tr>
          <tr><td>労働組合法</td><td>労働組合運営の退職代行による交渉権</td><td>労働委員会</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <BannerAB pageSlug={slug} position="bottom" />

  <section class="lp-section">
    <div class="section-num">SECTION 04</div>
    <h2>退職代行Jobs (アクセストレード経由) の公開情報整理</h2>
    <p>本サイトが PR として取り上げる「退職代行Jobs」(アクセストレード経由) について、新人・新卒の退職代行に関係する公開情報を整理します。</p>
    <ul>
      <li>✅ <strong>労働組合運営</strong>: 合同労組による退職交渉が可能とされる選択肢</li>
      <li>✅ <strong>弁護士監修</strong>: 法的観点での助言が含まれるとされる選択肢</li>
      <li>✅ <strong>24時間対応</strong>: 緊急時の対応が可能とされる選択肢</li>
      <li>✅ <strong>全額返金保証</strong>: 公開情報による表記 (詳細は公式公開情報をご確認ください)</li>
      <li>✅ <strong>後払い対応</strong>: 後払い決済の選択肢があるとされる傾向</li>
    </ul>
  </section>

  <section class="lp-section">
    <div class="section-num">SECTION 05</div>
    <h2>まとめ — 自分の状況に合う選択肢を専門家と相談する</h2>
    <p>
      新人・新卒の退職代行は、<strong>公的保護の理解 + 退職代行サービスの活用検討 + 退職後の手続き準備</strong> の3点を整理した上で、自分の状況に合う選択肢を専門家と相談するのが現実的アプローチが一般的です。本人の意思尊重が前提とされており、無料相談・公的窓口の活用も選択肢とされます。
    </p>
  </section>

  <BannerAB pageSlug={slug} position="final" />

  <section class="faq-section">
    <h2>よくある質問</h2>
    {faq.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </section>

  <section class="lp-section">
    <h2>参考情報・公開出典</h2>
    <ul class="source-list">
      <li>労働基準法</li>
      <li>民法 (第627条 雇用契約解約)</li>
      <li>男女雇用機会均等法・育児介護休業法</li>
      <li>労働組合法</li>
      <li>厚生労働省「労働相談・窓口」</li>
      <li>国民生活センター「労働トラブル相談事例」</li>
    </ul>
  </section>

  <section class="lp-section" id="sec-related" aria-labelledby="related-h">
    <div class="container">
      <p class="section-num">関連記事</p>
      <h2 id="related-h">関連する記事</h2>
      <ul class="related-links" style="line-height:1.9;">
        <li><a href="https://taishoku-info.pages.dev/taishoku-daikou-shinsotsu/">新卒の退職代行｜入社1年目の早期退職と親対応の選び方を整理(2026年版・PR)</a></li>
        <li><a href="https://taishoku-info.pages.dev/arbeit-taishoku/">アルバイト退職代行 完全ガイド｜学生バイト・短期バイト・掛け持ちバイトの活用判断（2026年5月時点・公開情報整理・PR）</a></li>
        <li><a href="https://taishoku-info.pages.dev/hoiku-taishoku/">保育士の退職代行｜保育園・幼稚園の人手不足・年度途中退職と業者選び5軸（2026年版・PR）</a></li>
        <li><a href="https://taishoku-info.pages.dev/shinjin-1nen/">新卒1年目・第二新卒の退職代行｜早期退職の判断軸と業者選び5軸（2026年版・PR）</a></li>
        <li><a href="https://taishoku-info.pages.dev/shiyoukikan-taishoku/">試用期間中の退職代行ガイド｜利用できるか・流れ・試用期間ならではの確認点（2026年版・PR）</a></li>
      </ul>
    </div>
  </section>


