---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const slug = "shitauke-haken-betsu";
const title = "下請け・派遣・別職場勤務の退職代行ガイド｜雇用形態別の進め方（2026年6月時点・PR）";
const description = "下請け・派遣・別職場勤務 (常駐型) の方が退職代行を検討する際の、雇用形態別の進め方を公開情報をもとに中立に整理した情報提供記事です（PR・アフィリエイト広告を含みます）。";
const breadcrumb = [
  { name: "ホーム", item: "/" },
  { name: "退職代行", item: "/" },
  { name: title, item: `/${slug}/` }
];
const faq = [
  { q: '派遣社員でも退職代行は使えますか？', a: '派遣社員も労働者として保護されており、退職代行の活用が可能とされています。' },
  { q: '派遣先と派遣元どちらに退職を伝えますか？', a: '退職代行サービスは雇用元 (派遣元) との退職交渉を行うとされています。' },
  { q: '契約期間の途中でも退職可能ですか？', a: '契約期間の途中退職は契約解除条件によりますが、やむを得ない事由がある場合は退職可能が一般的です。詳細は退職代行サービスへの相談が推奨されます。' },
];
---

<RichLayout {title} {description} {breadcrumb} {faq} {slug}
  publishedDate="2026-06-03">
<!-- PERSPECTIVE_LEAD_BOX_START -->
<aside class="perspective-lead" style="background:#f8fafc;border-left:4px solid #0ea5e9;padding:16px 20px;margin:24px 0;border-radius:6px;">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
    <span style="font-size:1.4em;">🔍</span>
    <strong style="color:#0c4a6e;">この LP の独立価値</strong>
  </div>
  <p style="margin:4px 0;font-size:0.95em;color:#0f172a;"><strong>視点 (Perspective):</strong> 判断・診断</p>
  <p style="margin:4px 0;font-size:0.95em;color:#0f172a;"><strong>独自 angle:</strong> shitauke haken betsu に焦点を当てた 判断・診断 視点の独自解説</p>
  <p style="margin:4px 0;font-size:0.9em;color:#475569;"><strong>他 LP との違い:</strong> 他 LP が一般的に 判断・診断 全体を扱うのに対し、本 LP は shitauke-haken-betsu に絞り込む</p>
</aside>
<!-- PERSPECTIVE_LEAD_BOX_END -->


  <section class="fv">
    <div class="fv-pill">下請け/派遣の退職 / 公的保護整理</div>
    <h1>下請け・派遣・別職場勤務の退職代行を検討する方へ — 進め方と公開情報整理</h1>
    <p class="lede">本記事では <strong>下請け・派遣・別職場勤務の退職代行向けの判断軸・進め方・公的保護制度</strong> を公開情報をもとに中立に整理します。退職は労働者の権利として保護されており、本人の意思尊重が前提のケースが多く見られます。</p>
    <ul class="fv-bullets">
      <li>下請け/派遣の退職の基本知識</li>
      <li>労働基準法・関連法令の公的保護</li>
      <li>退職代行サービスの活用検討</li>
      <li>退職後の手続き準備</li>
    </ul>
    <PRBadge pageSlug={slug} />
    <div class="fv-meta">最終更新: 2026年6月3日 | 労働基準法・関連法令準拠 | 効果は個人差あり</div>
  </section>

  <BannerAB pageSlug={slug} position="hero" />

  <section class="lp-section">
    <div class="section-num">SECTION 01</div>
    <h2>下請け・派遣の退職代行の基本</h2>
    <p>下請け・派遣社員・別職場常駐型勤務の方の退職代行は、雇用元 (派遣元) と勤務先 (派遣先・元請け) の二重構造への対応が必要とされる傾向にあります。<br>労働者派遣法では、雇用関係の主体は派遣元・労務指揮の主体は派遣先とされており、退職代行サービスは雇用元 (派遣元) との退職交渉を行うが一般的です。<br>退職代行Jobs (アクセストレード経由) は労働組合運営の選択肢で、派遣・下請けの退職相談にも対応すると公表されています。<br>なお、下請け・派遣社員の場合、契約期間 (更新時期)・契約解除条件・有給消化等の権利が雇用元との契約に基づくため、契約書類の事前確認が現実的アプローチと示されています。</p>
  </section>

  <BannerAB pageSlug={slug} position="middle" />

  <section class="lp-section">
    <div class="section-num">SECTION 02</div>
    <h2>下請け・派遣の退職代行の進め方</h2>
    <p>下請け・派遣の退職代行の進め方は、雇用元への退職連絡・派遣先での引き継ぎ・有給消化等の手続きの3点が出発点となります。契約書類の確認が推奨されるのケースが多く見られます。</p>
    <ul>
        <li><strong>雇用元への退職連絡</strong>: 退職代行サービスは雇用元 (派遣元) との退職交渉を行うと公表されています。</li>
        <li><strong>派遣先での引き継ぎ</strong>: 派遣先での業務引き継ぎは雇用元との連携で進められるとされています。</li>
        <li><strong>有給消化等の手続き</strong>: 残日数・契約終了日等を雇用元との契約書で事前確認することが推奨されるが一般的です。</li>
    </ul>
  </section>

  <section class="lp-section">
    <div class="section-num">SECTION 03</div>
    <h2>公的保護制度の整理</h2>
    <div class="compare-wrap">
      <table class="compare-table">
        <thead><tr><th>制度</th><th>内容</th><th>窓口</th></tr></thead>
        <tbody>
          <tr><td>労働基準法</td><td>退職の自由・有給消化・最終給与等の保護</td><td>労働基準監督署</td></tr>
          <tr><td>民法627条</td><td>退職意思表示から2週間で雇用契約終了</td><td>労働基準監督署</td></tr>
          <tr><td>男女雇用機会均等法</td><td>妊娠・出産を理由とする不利益取扱禁止</td><td>都道府県労働局</td></tr>
          <tr><td>労働組合法</td><td>労働組合運営の退職代行による交渉権</td><td>労働委員会</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <BannerAB pageSlug={slug} position="bottom" />

  <section class="lp-section">
    <div class="section-num">SECTION 04</div>
    <h2>退職代行Jobs (アクセストレード経由) の公開情報整理</h2>
    <p>本サイトが PR として取り上げる「退職代行Jobs」(アクセストレード経由) について、下請け・派遣・別職場勤務の退職代行に関係する公開情報を整理します。</p>
    <ul>
      <li>✅ <strong>労働組合運営</strong>: 合同労組による退職交渉が可能とされる選択肢</li>
      <li>✅ <strong>弁護士監修</strong>: 法的観点での助言が含まれるとされる選択肢</li>
      <li>✅ <strong>24時間対応</strong>: 緊急時の対応が可能とされる選択肢</li>
      <li>✅ <strong>全額返金保証</strong>: 公開情報による表記 (詳細は公式公開情報をご確認ください)</li>
      <li>✅ <strong>後払い対応</strong>: 後払い決済の選択肢があるとされる傾向</li>
    </ul>
  </section>

  <section class="lp-section">
    <div class="section-num">SECTION 05</div>
    <h2>まとめ — 自分の状況に合う選択肢を専門家と相談する</h2>
    <p>
      下請け・派遣・別職場勤務の退職代行は、<strong>公的保護の理解 + 退職代行サービスの活用検討 + 退職後の手続き準備</strong> の3点を整理した上で、自分の状況に合う選択肢を専門家と相談するのが現実的アプローチが知られています。本人の意思尊重が前提とされており、無料相談・公的窓口の活用も選択肢とされます。
    </p>
  </section>

  <BannerAB pageSlug={slug} position="final" />

  <section class="faq-section">
    <h2>よくある質問</h2>
    {faq.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </section>

  <section class="lp-section">
    <h2>参考情報・公開出典</h2>
    <ul class="source-list">
      <li>労働基準法</li>
      <li>民法 (第627条 雇用契約解約)</li>
      <li>男女雇用機会均等法・育児介護休業法</li>
      <li>労働組合法</li>
      <li>厚生労働省「労働相談・窓口」</li>
      <li>国民生活センター「労働トラブル相談事例」</li>
    </ul>
  </section>

  <section class="lp-section" id="sec-related" aria-labelledby="related-h">
    <div class="container">
      <p class="section-num">関連記事</p>
      <h2 id="related-h">関連する記事</h2>
      <ul class="related-links" style="line-height:1.9;">
        <li><a href="https://taishoku-info.pages.dev/taishoku-daikou-haken/">派遣社員の退職代行ガイド｜派遣元への伝え方・契約期間の扱い・確認ポイント（2026年版・PR）</a></li>
        <li><a href="https://taishoku-info.pages.dev/arbeit-taishoku/">アルバイト退職代行 完全ガイド｜学生バイト・短期バイト・掛け持ちバイトの活用判断（2026年5月時点・公開情報整理・PR）</a></li>
        <li><a href="https://taishoku-info.pages.dev/atobarai/">退職代行の後払いOK｜手元資金ゼロでも即日退職できる選び方（2026年版・PR）</a></li>
        <li><a href="https://taishoku-info.pages.dev/bengoshi-hikaku-2026/">退職代行は弁護士に頼むべき？費用・メリット・選び方を徹底解説2026年版（PR）</a></li>
        <li><a href="https://taishoku-info.pages.dev/black-kigyou/">ブラック企業からの退職に退職代行が選ばれる理由｜法的根拠と対処法（2026年版・PR）</a></li>
      </ul>
    </div>
  </section>


