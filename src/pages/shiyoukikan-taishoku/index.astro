---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '試用期間中の退職代行ガイド｜利用できるか・流れ・試用期間ならではの確認点（2026年版・PR）';
const description = '試用期間中に退職代行を利用する際の、利用可否・退職の法的な前提・試用期間ならではの確認ポイントを整理した情報提供記事です。本採用前の退職の考え方も解説（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '試用期間中の退職代行' },
];

const faq = [
  { q: '試用期間中でも本当に退職代行は利用できますか？', a: 'はい、利用可能とされます。試用期間は法的に「解約権留保付労働契約」と解釈されますが、労働契約自体は成立しています。そのため、労働者には退職の自由が保障されており（民法第627条）、退職の意思表示を代行するサービスの利用は問題ないと一般に考えられています。' },
  { q: '試用期間中の退職は、経歴に傷がつくのでしょうか？', a: '短期離職が将来の転職活動に影響する可能性は否定できません。しかし、試用期間は労働者と企業の双方が適性を見極めるための期間です。ミスマッチを理由とした早期の決断は、正直に説明できれば理解を得られる場合も多いとされます。職務経歴の記載は任意ですが、正直に申告することが推奨されます。' },
  { q: '試用期間中に即日退職したい場合、退職代行は対応してくれますか？', a: '多くの退職代行サービスが即日退職の相談に対応しています。法律上は退職の意思表示から2週間で雇用契約が終了するのが原則ですが（民法第627条）、会社との交渉により即時合意退職となるか、残りの期間を有給消化や欠勤扱いとすることで、実質的な即日退職が実現する可能性があります。' },
  { q: '試用期間中の退職で、会社から損害賠償を請求されることはありますか？', a: '労働者の退職によって会社に直接的かつ重大な損害を与えた場合などを除き、損害賠償請求が認められる可能性は極めて低いとされます。厚生労働省のガイドラインでも、労働者の退職の自由は尊重されるべきと示されています。不安な場合は弁護士が運営する退職代行サービスへの相談が選択肢となります。' },
  { q: '試用期間中の退職代行費用は、通常の退職代行と同じですか？', a: 'はい、一般的に費用は同じです。試用期間中であっても、退職代行サービスが行う会社への連絡や手続きの代行といった基本的な業務内容は変わらないためです。料金体系はサービス提供者により異なるため、依頼前に公式サイトでサービス範囲と費用を必ず確認することが重要です。' },
];
---

