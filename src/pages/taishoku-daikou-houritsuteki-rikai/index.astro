const title = '退職代行の法的根拠の整理｜民法627条・労働組合法・弁護士法の3軸（2026年版・PR）';
const description = '退職代行の法的根拠を、民法第627条・労働組合法第6条・弁護士法第72条・公開情報をもとに中立的に整理した情報提供記事です(PR・アフィリエイト広告を含みます)。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行', url: '/' },
  { name: '法的根拠' },
];

const faq = [
  { q: '退職代行は違法ではないですか？', a: '退職代行サービス自体は違法ではない整理が公表されているとされています。民法第627条に基づく退職意思表示の伝達は本人以外でも整理される選択肢があるとされ、労働組合法第6条に基づく労働組合運営の退職代行・弁護士法第72条範囲内での弁護士運営の退職代行は法的に整理される選択肢が公表されているとされています。' },
  { q: '民法第627条の「2週間ルール」とは何ですか？', a: '民法第627条第1項に基づき、期間の定めのない雇用契約（無期雇用）では、労働者は退職意思表示から<strong>2週間後に契約終了</strong>する整理が選択肢として公表されているとされています。会社の承諾は不要とされ、労働者の一方的な意思表示で退職が成立する整理が公表されているとされています。' },
  { q: '労働組合運営と一般業者の法的違いは？', a: '労働組合運営の退職代行は<strong>労働組合法第6条の団体交渉権</strong>に基づき会社と賃金・退職金等の<strong>交渉</strong>が整理される選択肢があるとされています。一般業者（労働組合・弁護士運営でない）は「意思の伝達」のみが整理される選択肢があり、交渉は弁護士法第72条（非弁行為の禁止）に抵触する選択肢があるとされています。' },
  { q: '弁護士法第72条（非弁行為の禁止）とは？', a: '弁護士法第72条に基づき、弁護士でない者が報酬を得る目的で法律事件の代理・交渉等を行うことは禁止される整理が公表されているとされています。退職代行の場合、退職意思の<strong>伝達</strong>は非弁行為に該当しない選択肢が一般的とされ、賃金・退職金の<strong>交渉</strong>は弁護士または労働組合（団体交渉権）のみが整理される選択肢があるとされています。' },
  { q: '会社が退職を認めない場合の法的整理は？', a: '民法第627条に基づき、無期雇用契約の労働者は会社の承諾なく退職可能な選択肢が公表されているとされています。会社が退職を認めない場合でも、退職意思表示から2週間経過後に契約終了する整理が公表されているとされています。引き留めが強硬な場合は労働基準監督署・労働組合・弁護士への相談が選択肢として整理されているとされています。' },
];
