import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行 家族にバレない進め方の一般整理｜情報共有の範囲と配慮ポイント（2026年版・PR）';
const description = '家族バレ防止が退職代行の利用を検討する際の、役職特有の論点（引き継ぎ・契約形態・競業避止など）・運営形態ごとの対応範囲・確認ポイントを、公開情報をもとに中立的に整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '家族バレ防止の退職代行' },
];

const faq = [
  { q: '退職代行を使うと、なぜ家族にバレる可能性があるのですか？', a: '主な原因は、会社から本人確認や貸与物返却のために自宅や緊急連絡先へ電話がかかること、または離職票などの公的書類が自宅に郵送されることです。個人情報保護法に基づき、代行業者は本人以外への連絡をしないよう会社に要請しますが、会社の対応次第でリスクは残るため、事前の対策が重要とされます。' },
  { q: '退職代行業者へ依頼する際、家族バレ防止のために特に伝えるべきことは何ですか？', a: '「家族への連絡は一切しないでほしい」という意思を明確に伝えることが最優先です。連絡先を本人の携帯電話番号のみに限定し、郵送物は現住所に送付するよう、具体的な要望を契約前に伝えましょう。これらの条件をサービス提供者との契約内容に含めることが望ましいと一般に考えられています。' },
  { q: '会社が緊急連絡先として登録されている実家に連絡してくる可能性はありますか？', a: '労働契約上の正当な理由なく、本人の許可なしに緊急連絡先へ連絡することは、プライバシーの観点から問題となる可能性があります。しかし、会社の判断で連絡されるケースもゼロではないため、代行業者を通じて「連絡は必ず本人の携帯電話へ」と強く要請しておくことが、トラブル防止につながります。' },
  { q: '健康保険や年金の手続きで、家族にバレることはありますか？', a: '退職後は国民健康保険などへの切り替えが必要となり、その手続きに関する通知書や保険証が自宅住所に届きます。これらの郵便物を家族に見られないよう、ご自身で郵便受けを管理するなどの注意が必要です。手続きの詳細は、厚生労働省のウェブサイト等で確認し、計画的に進めることが推奨されます。' },
  { q: '退職代行を利用して、家族バレを完全に防ぐことはできますか？', a: '「完全」や「絶対」に防ぐことを保証するのは難しいとされます。しかし、実績のある退職代行業者を選び、連絡方法や書類の送付先について会社側と明確な取り決めを行うことで、家族に知られるリスクを大幅に低減させることが期待できます。事前の打ち合わせと業者選定が極めて重要です。' },
];
---

