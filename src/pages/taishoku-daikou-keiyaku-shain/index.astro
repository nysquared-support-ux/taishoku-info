---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '契約社員の退職代行ガイド｜期間満了前の退職 / 契約途中の退職と確認ポイント（2026年版・PR）';
const description = '契約社員 (有期雇用) が退職代行を利用する場合の論点を、期間満了前 / 契約途中・やむを得ない事由・運営形態別の対応範囲を整理した情報提供記事です。公開情報をもとに中立に整理 (PR・アフィリエイト広告を含みます)。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '契約社員の退職代行' },
];

const faq = [
  { q: '契約社員が契約期間の途中で退職代行を使うのは法的に問題ないですか？', a: '「やむを得ない事由」があれば、契約期間の途中でも退職は可能とされます。民法第628条では、やむを得ない事由がある場合、当事者は直ちに契約を解除できると定めています。この事由には、本人の心身の不調やハラスメントなどが含まれる可能性があり、退職代行サービスはこれらの状況を基に会社との手続きを代行することが期待されます。' },
  { q: '退職代行で契約途中に辞めた場合、損害賠償を請求されるリスクはありますか？', a: '理論上のリスクはゼロではありませんが、実際に請求が認められるケースは稀とされます。労働契約法第17条1項は、使用者が有期契約を理由に労働者を不当に拘束することを禁じています。会社側が損害を立証するハードルは高く、不当な請求は認められない可能性が高いです。不安な場合は弁護士が運営する退職代行への相談が推奨されます。' },
  { q: '契約満了前の退職で必要な「やむを得ない事由」とは具体的に何ですか？', a: '法律で明確に定義されていませんが、一般に本人や家族の病気、介護、会社側によるハラスメント、賃金未払い、契約内容との著しい相違などが該当し得るとされます。厚生労働省の資料でも、労働条件の明示義務違反などが問題となるケースが示されています。自身の状況が該当するかは、専門家への相談を通じて判断するのが確実です。' },
  { q: '契約社員が退職代行を使う際の費用相場は、正社員と異なりますか？', a: '費用相場は雇用形態によって大きく変わることはなく、正社員の場合とほぼ同等です。民間企業運営で2〜3万円、労働組合運営で2.5〜3万円、弁護士法人運営で5万円以上が一般的な目安とされます。ただし、損害賠償リスクへの対応など、法的な交渉が想定される場合は、弁護士運営のサービスを選ぶことが賢明と考えられます。' },
  { q: '退職代行を使って契約途中で辞めた事実は、次の転職で不利になりますか？', a: '退職代行の利用自体が直接的に転職で不利になる可能性は低いとされます。労働基準法第22条により、会社は労働者が請求しない事項を退職証明書に記載できません。そのため、退職の経緯が次の応募先に伝わることは通常ありません。面接では、退職理由を前向きな形で説明することが重要です。' },
];
