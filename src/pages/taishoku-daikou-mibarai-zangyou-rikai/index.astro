const description = '退職代行を利用して未払い残業代を請求する際の整理を、労働基準法・労働組合法・公開情報をもとに中立的に整理した情報提供記事です(PR・アフィリエイト広告を含みます)。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行', url: '/' },
  { name: '未払い残業代' },
