---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行の流れ｜申込から退職完了までの7ステップ（2026年版・PR）';
const description = '退職代行サービスの利用フロー (相談→申込→入金→打合せ→連絡実行→書類受取→退職完了) を7ステップで整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行の流れ' },
];

const faq = [
  { q: '退職代行の流れで最も重要なステップはどれですか？', a: '「代行業者による退職連絡の実行」が最も重要とされます。この段階で利用者の退職意思が正式に会社へ伝達されるためです。民法第627条では退職の自由が認められていますが、意思伝達の正確性が円滑な退職手続きの鍵となります。' },
  { q: '申し込みから退職完了まで、平均でどのくらいの期間がかかりますか？', a: '申込み当日に会社へ連絡が完了するケースも多いですが、離職票などの書類受取りまで含めると、一般的に2週間から1ヶ月程度が目安です。これは、法律で定められた退職の申し入れ期間（通常2週間）や、会社の事務手続きにかかる時間を考慮したものです。' },
  { q: '退職代行の費用はどのタイミングで支払うのが一般的ですか？', a: '無料相談やヒアリングの後、正式に依頼を決定し、業者が会社へ連絡する「前」に支払うのが一般的です。多くの場合、入金確認をもって正式な契約成立とされ、具体的な代行業務が開始されます。詳細は各サービスの料金ページをご確認ください。' },
  { q: '退職代行の流れの中で、会社から直接連絡が来る可能性はありますか？', a: '代行業者は「連絡は本人にしないように」と伝えますが、会社側が直接連絡してくる可能性はゼロではありません。その際は応答せず、代行業者に報告するのが基本です。国民生活センターも、退職代行に関するトラブルについて注意喚起を行っています。' },
  { q: '退職代行の一連の流れを利用する最大のメリットは何ですか？', a: '最大のメリットは、会社の上司や同僚と一切顔を合わせたり、直接話したりすることなく、退職手続きを進められる点です。これにより、精神的な負担が大幅に軽減され、次のステップに集中しやすくなることが期待されます。' },
];
---

