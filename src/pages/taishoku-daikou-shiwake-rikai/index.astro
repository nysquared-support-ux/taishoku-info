---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行と退職金・最終給与の清算整理｜未払い時の3対応経路（2026年版・PR）';
const description = '退職代行を利用する際の退職金・最終給与・未払い賃金の清算整理を、労働基準法・退職金規程・公開情報をもとに中立的に整理した情報提供記事です(PR・アフィリエイト広告を含みます)。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行', url: '/' },
  { name: '退職金・最終給与清算' },
];

const faq = [
  { q: '退職代行を利用しても退職金は受け取れますか？', a: '退職金規程に基づく退職金支払い義務は、退職代行利用の有無に関わらず会社に整理される選択肢が公表されているとされています。退職金は労働者の正当な権利として整理されているとされています。受け取りに不安がある場合は弁護士運営・労働組合運営の退職代行を選ぶ整理が推奨される選択肢として公表されているとされています。' },
  { q: '退職金の支払い時期はいつですか？', a: '退職金の支払い時期は退職金規程・労働協約により整理される選択肢が公表されているとされています。一般的には退職後1〜3ヶ月以内の支払いが整理される選択肢が多いとされています。退職金規程がない場合・口頭約束のみの場合は支払い義務の整理が異なる選択肢があるとされています。' },
  { q: '最終給与の支払いは退職後いつまでですか？', a: '労働基準法第23条に基づき、退職労働者の請求があった場合、会社は<strong>7日以内</strong>に賃金（給与・退職金以外）を支払う義務が整理される選択肢が公表されているとされています。退職金は別規程による整理が一般的とされています。' },
  { q: '退職金規程がない会社でも退職金はもらえますか？', a: '退職金規程・労働協約・労働契約に退職金支払いの整理が明記されていない場合、退職金支払い義務は会社に整理されない選択肢が一般的とされています。但し、就業規則・慣行・口頭約束等で整理される選択肢があるとされ、個別事情により対応が異なる選択肢があるとされています。' },
  { q: '退職金が未払いの場合、どう請求すればいいですか？', a: '労働基準監督署への申告（労働基準法第104条）・労働組合の団体交渉・弁護士運営の退職代行による法的請求・労働審判・民事訴訟等の選択肢が整理されているとされています。退職金請求権の時効は5年（民法第166条）として整理される選択肢が公表されているとされています。' },
];
---

<RichLayout title={title} description={description} publishedDate="2026-06-07" breadcrumb={breadcrumb} faq={faq}>
<!-- PERSPECTIVE_LEAD_BOX_START -->
<aside class="perspective-lead" style="background:#f8fafc;border-left:4px solid #0ea5e9;padding:16px 20px;margin:24px 0;border-radius:6px;">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
    <span style="font-size:1.4em;">🔍</span>
    <strong style="color:#0c4a6e;">この LP の独立価値</strong>
  </div>
  <p style="margin:4px 0;font-size:0.95em;color:#0f172a;"><strong>視点 (Perspective):</strong> 判断・診断</p>
  <p style="margin:4px 0;font-size:0.95em;color:#0f172a;"><strong>独自 angle:</strong> taishoku daikou shiwake に焦点を当てた 判断・診断 視点の独自解説</p>
  <p style="margin:4px 0;font-size:0.9em;color:#475569;"><strong>他 LP との違い:</strong> 他 LP が一般的に 判断・診断 全体を扱うのに対し、本 LP は taishoku-daikou-shiwake-rikai に絞り込む</p>
</aside>
<!-- PERSPECTIVE_LEAD_BOX_END -->

  <PRBadge />
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">退職代行 / 退職金・給与清算</span>
      <h1 id="fv-h1"><span class="accent">退職代行と退職金・最終給与の清算整理</span><br />未払い時の3対応経路</h1>
      <p class="lede">「退職金がもらえるか不安」「最終給与の振込が遅い」という方向けに、<strong>退職金・最終給与・未払い賃金の清算整理</strong>を労働基準法・退職金規程ベースで中立的に整理します。退職代行Jobs 等の労働組合運営サービスでは、団体交渉権に基づく賃金・退職金請求の整理が公表されているとされています。</p>
      <ul class="fv-bullets">
        <li>退職金規程と支払い義務の整理</li>
        <li>最終給与の7日以内支払い義務（労基法23条）</li>
        <li>未払い時の3対応経路（労組/弁護士/労基署）</li>
        <li>業者選び3条件（労組or弁護士 / 賃金請求対応 / 実績）</li>
      </ul>
      <PRBadge pageSlug="taishoku-daikou-shiwake-rikai" />
      <div class="fv-meta">
        <span><b>公開日</b> 2026-06-07</span><span><b>最終更新</b> 2026-06-07</span>
        <span><b>編集</b> NY-squared 編集部</span><span><b>所要</b> 約 7 分</span>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2>退職金の支払い義務と法的整理</h2>
      <h3>1-1. 退職金規程・労働協約の整理</h3>
      <p>退職金の支払い義務は、退職金規程・労働協約・労働契約に基づき整理される選択肢が公表されているとされています。退職金規程がある会社では、勤続年数・基本給・退職事由（自己都合/会社都合）等により算定される選択肢があるとされています。退職金規程がない会社・口頭約束のみの会社では支払い義務の整理が異なる選択肢があるとされています。</p>
      <h3>1-2. 自己都合 vs 会社都合の退職金算定</h3>
      <p>自己都合退職と会社都合退職では、退職金規程により算定額が異なる選択肢が一般的とされています。会社都合退職の方が支給率が高く整理される選択肢が公表されているとされています。退職代行を経由する場合、退職事由は「自己都合退職」として整理される選択肢が一般的とされています。</p>
      <h3>1-3. 退職金請求権の時効（民法166条）</h3>
      <p>退職金請求権の時効は民法第166条に基づき<strong>5年</strong>として整理される選択肢が公表されているとされています。退職後5年以内に請求すれば法的に整理される選択肢があるとされています。但し、退職金規程の整理により時効起算日が異なる選択肢があるとされています。</p>
    </div>
  </section>

  <BannerAB position="middle" />

  <section class="lp-section" id="sec-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2>最終給与・賃金の支払い義務</h2>
      <h3>2-1. 労働基準法第23条（金品の返還）</h3>
      <p>労働基準法第23条に基づき、退職労働者の請求があった場合、会社は<strong>7日以内</strong>に賃金（給与）・積立金・保証金・貯蓄金・その他労働者の権利に属する金品を支払う義務が整理される選択肢が公表されているとされています。退職金は別規程による整理が一般的とされています。</p>
      <h3>2-2. 未払い賃金の請求権時効（労基法115条）</h3>
      <p>労働基準法第115条の改正（2020年4月施行）により、賃金請求権の時効は<strong>3年</strong>（経過措置）に整理されているとされています。最終給与・残業代・未払い賃金等の請求は時効内に整理することが選択肢として推奨されているとされています。</p>
      <h3>2-3. 賞与（ボーナス）の整理</h3>
      <p>賞与は労働契約・就業規則・労働協約に支給時期・支給額の整理が明記されている場合に限り支払い義務が整理される選択肢が公表されているとされています。退職時に賞与の支給日に在籍していない場合は支給義務が整理されない選択肢が一般的とされています。</p>
    </div>
  </section>

  <section class="lp-section" id="sec-3">
    <div class="container">
      <p class="section-num">SECTION / 03</p>
      <h2>未払い時の3対応経路</h2>
      <h3>3-1. 経路①: 労働組合の団体交渉</h3>
      <p>退職代行Jobs 等の労働組合運営サービスでは、団体交渉権（労働組合法第6条）に基づき会社との未払い賃金・退職金支払い交渉を整理する選択肢が公表されているとされています。会社が交渉に応じる場合は和解金・分割払い等の整理が選択肢として公表されているとされています。</p>
      <h3>3-2. 経路②: 弁護士運営による法的請求</h3>
      <p>弁護士運営または弁護士監修の退職代行サービスでは、内容証明郵便による催告・労働審判・民事訴訟への移行が選択肢として整理されているとされています。労働審判は原則3回以内・最短2-3ヶ月の整理が公表されており、付加金（労基法114条）の請求も選択肢として整理されているとされています。</p>
      <h3>3-3. 経路③: 労働基準監督署への申告</h3>
      <p>労働基準法第104条に基づき、労働者は労働基準監督署への申告（賃金未払い・労働基準法違反）が選択肢として整理されているとされています。労基署は会社への是正勧告・行政指導を行う整理が公表されており、刑事罰（労基法119条）への進展も選択肢として整理されているとされています。</p>
    </div>
  </section>

  <BannerAB position="middle2" />

  <section class="lp-section" id="sec-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2>退職代行Jobs の清算サポート整理</h2>
      <h3>4-1. 労働組合運営による交渉権の整理</h3>
      <p>退職代行Jobs は労働組合（合同労組）が運営する選択肢が公表されているとされています。利用者は組合員として加入し、団体交渉権に基づく賃金・退職金・有給消化等の交渉整理が選択肢として公表されているとされています。</p>
      <h3>4-2. 全額返金保証の整理</h3>
      <p>退職代行Jobs では<strong>全額返金保証</strong>の整理が公表されているとされています。退職不成立時の返金対応が選択肢として整理されており、利用者の経済的リスク軽減の整理が公表されているとされています。詳細は公式サイトでの確認が推奨される選択肢として公表されているとされています。</p>
      <h3>4-3. 弁護士監修の法的整理</h3>
      <p>退職代行Jobs は<strong>弁護士監修</strong>の整理が公表されているとされています。法的観点での整理・労基法整合性確認等の選択肢が公表されているとされています。労働組合の交渉権と弁護士監修の組み合わせにより、賃金・退職金の整理対応が選択肢として公表されているとされています。</p>
    </div>
  </section>

  <section class="lp-section" id="sec-5">
    <div class="container">
      <p class="section-num">SECTION / 05</p>
      <h2>業者選び3条件と退職代行Jobs の整理</h2>
      <div class="branch-grid">
        <div class="branch-box">
          <h3>業者選び3条件</h3>
          <ul>
            <li><strong>① 労働組合 or 弁護士運営</strong> — 賃金請求の整理</li>
            <li><strong>② 賃金請求対応</strong> — 公式サイトでの整理表明</li>
            <li><strong>③ 全額返金保証</strong> — 退職不成立リスクの整理</li>
          </ul>
        </div>
        <div class="branch-box">
          <h3>退職代行Jobs の整理</h3>
          <ul>
            <li><strong>労働組合運営</strong> — 団体交渉権の整理</li>
            <li><strong>全額返金保証</strong> — 退職不成立時の整理</li>
            <li><strong>24時間対応</strong> — 深夜・早朝の相談</li>
            <li><strong>弁護士監修</strong> — 法的整理の選択肢</li>
            <li><strong>賃金・退職金交渉実績</strong> — 公開情報の整理</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <BannerAB position="bottom" />

  <section class="lp-section" id="sec-6">
    <div class="container">
      <p class="section-num">SECTION / 06</p>
      <h2>退職金・最終給与の整理タイムライン</h2>
      <h3>6-1. 退職日 〜 7日以内</h3>
      <p>労働基準法第23条に基づき、最終給与（月給・日給・時給制の未払い分）は退職労働者の請求から7日以内に支払う義務が整理される選択肢が公表されているとされています。退職代行Jobs では退職時の労働者の請求権整理を会社に伝達する選択肢が公表されているとされています。</p>
      <h3>6-2. 退職後1〜3ヶ月: 退職金支払い</h3>
      <p>退職金規程に基づき、退職金は退職後1〜3ヶ月以内に支払う整理が一般的とされています。退職金規程・労働協約により支払い時期は異なる選択肢があるとされています。未払いの場合は労働組合の団体交渉・弁護士の法的請求が選択肢として整理されているとされています。</p>
      <h3>6-3. 退職後3ヶ月以降: 公的支援の整理</h3>
      <p>退職後3ヶ月以降は、雇用保険の失業給付（基本手当）・国民健康保険・国民年金の手続きが整理される選択肢が公表されているとされています。離職票・退職証明書・源泉徴収票の受領が必要とされ、退職代行Jobs では受領手続きの整理サポートが選択肢として公表されているとされています。</p>
    </div>
  </section>

  <section class="lp-section" id="sec-7">
    <div class="container">
      <p class="section-num">SECTION / 07</p>
      <h2>まとめと公的相談窓口</h2>
      <p>退職代行を経由する場合でも、退職金・最終給与・未払い賃金の請求権は労働者の正当な権利として整理される選択肢が公表されているとされています。<strong>労働組合運営または弁護士運営・監修</strong>のサービスを選ぶことで、団体交渉権・法的請求権による整理対応が選択肢として公表されているとされています。</p>
      <p>退職代行Jobs では <strong>労働組合運営 + 全額返金保証 + 24時間対応 + 弁護士監修</strong> の整理が公表されており、賃金・退職金清算の整理対応が選択肢として公表されているとされています。</p>
      <p><strong>公的相談窓口</strong>: 労働基準監督署（賃金未払い申告・労基法104条）/ 各都道府県の労働相談センター（無料相談）/ 法テラス（弁護士相談）/ 日本労働組合総連合会（労組相談）等の選択肢が公表されているとされています。</p>
      <BannerAB position="final" />
    </div>
  </section>
  <section class="lp-section" id="sec-related" aria-labelledby="related-h">
    <div class="container">
      <p class="section-num">関連記事</p>
      <h2 id="related-h">関連する記事</h2>
      <ul class="related-links" style="line-height:1.9;">
