---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const slug = "utsu-taishoku";
const title = "うつ病・メンタル不調の退職代行ガイド｜診断書・休職判断（2026年6月時点・PR）";
const description = "うつ病・メンタル不調で退職を検討する方向けに、退職代行・休職・診断書・公的保護を公開情報をもとに中立に整理した情報提供記事です（PR・アフィリエイト広告を含みます）。";
const breadcrumb = [
  { name: "ホーム", item: "/" },
  { name: "退職代行", item: "/" },
  { name: title, item: `/${slug}/` }
];
const faq = [
  { q: '診断書なしで退職代行を使えますか？', a: '診断書は退職代行の必須条件ではないとされていますが、傷病手当金・労災申請等で必要となるケースがあるとされます。' },
  { q: '休職と退職どちらが良いですか？', a: '個別の状況により異なるが一般的です。医師・産業医・退職代行サービスへの相談が推奨されます。' },
  { q: '退職後の生活費はどうなりますか？', a: '失業給付・傷病手当金等の公的支援が選択肢とされています。詳細はハローワーク・健康保険組合への相談が推奨されます。' },
];
---

<RichLayout {title} {description} {breadcrumb} {faq} {slug}
  publishedDate="2026-06-03" modifiedDate="2026-06-03">

  <section class="fv">
    <div class="fv-pill">うつ病・メンタル退職 / 公的保護整理</div>
    <h1>うつ病・メンタル不調の退職代行を検討する方へ — 進め方と公開情報整理</h1>
    <p class="lede">本記事では <strong>うつ病・メンタル不調の退職代行向けの判断軸・進め方・公的保護制度</strong> を公開情報をもとに中立に整理します。退職は労働者の権利として保護されており、本人の意思尊重が前提が一般的です。</p>
    <ul class="fv-bullets">
      <li>うつ病・メンタル退職の基本知識</li>
      <li>労働基準法・関連法令の公的保護</li>
      <li>退職代行サービスの活用検討</li>
      <li>退職後の手続き準備</li>
    </ul>
    <PRBadge pageSlug={slug} />
    <div class="fv-meta">最終更新: 2026年6月3日 | 労働基準法・関連法令準拠 | 効果は個人差あり</div>
  </section>

  <BannerAB pageSlug={slug} position="hero" />

  <section class="lp-section">
    <div class="section-num">SECTION 01</div>
    <h2>うつ病・メンタル不調の退職代行の基本</h2>
    <p>うつ病・メンタル不調を理由とする退職は、ご本人の心身の負担が大きい傾向にあり、退職代行サービスの活用が選択肢の一つのケースが多く見られます。<br><br>労働基準法・労働契約法では、労働者の健康を守る義務 (安全配慮義務) が使用者に課されており、健康上の理由による退職は労働者の権利と公表されています。<br><br>退職前に医師による診断書取得・休職制度の活用・労災申請等の選択肢を比較検討することが推奨されるのケースが多く見られます。<br><br>退職代行Jobs は労働組合運営の選択肢で、本人が会社と直接コミュニケーションを取らずに退職する選択肢の一つと示されています。<br><br>なお、メンタル不調が深刻な場合は、まず医療機関への受診が推奨される傾向で、退職判断は医師の助言も併せて検討するのが現実的アプローチが知られています。</p>
  </section>

  <BannerAB pageSlug={slug} position="middle" />

  <section class="lp-section">
    <div class="section-num">SECTION 02</div>
    <h2>うつ病・メンタル退職の進め方</h2>
    <p>うつ病・メンタル退職の進め方は、医療機関への受診・休職/退職の判断・退職代行サービスの活用検討の3点が出発点となります。心身の回復を最優先にすることが推奨されると公表されています。</p>
    <ul>
        <li><strong>医療機関への受診</strong>: メンタル不調が深刻な場合は、まず医療機関 (精神科・心療内科) への受診が推奨されるとされています。</li>
        <li><strong>休職/退職の判断</strong>: 休職制度の活用・退職の選択肢を医師・産業医と相談することが現実的アプローチが確認されています。</li>
        <li><strong>退職代行サービスの活用検討</strong>: 本人の心身負担を軽減する選択肢として、退職代行の活用が推奨されるが一般的です。</li>
    </ul>
  </section>

  <section class="lp-section">
    <div class="section-num">SECTION 03</div>
    <h2>公的保護制度の整理</h2>
    <div class="compare-wrap">
      <table class="compare-table">
        <thead><tr><th>制度</th><th>内容</th><th>窓口</th></tr></thead>
        <tbody>
          <tr><td>労働基準法</td><td>退職の自由・有給消化・最終給与等の保護</td><td>労働基準監督署</td></tr>
          <tr><td>民法627条</td><td>退職意思表示から2週間で雇用契約終了</td><td>労働基準監督署</td></tr>
          <tr><td>男女雇用機会均等法</td><td>妊娠・出産を理由とする不利益取扱禁止</td><td>都道府県労働局</td></tr>
          <tr><td>労働組合法</td><td>労働組合運営の退職代行による交渉権</td><td>労働委員会</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <BannerAB pageSlug={slug} position="bottom" />

  <section class="lp-section">
    <div class="section-num">SECTION 04</div>
    <h2>退職代行Jobs (アクセストレード経由) の公開情報整理</h2>
    <p>本サイトが PR として取り上げる「退職代行Jobs」(アクセストレード経由) について、うつ病・メンタル不調の退職代行に関係する公開情報を整理します。</p>
    <ul>
      <li>✅ <strong>労働組合運営</strong>: 合同労組による退職交渉が可能とされる選択肢</li>
      <li>✅ <strong>弁護士監修</strong>: 法的観点での助言が含まれるとされる選択肢</li>
      <li>✅ <strong>24時間対応</strong>: 緊急時の対応が可能とされる選択肢</li>
      <li>✅ <strong>全額返金保証</strong>: 公開情報による表記 (詳細は公式公開情報をご確認ください)</li>
      <li>✅ <strong>後払い対応</strong>: 後払い決済の選択肢があるとされる傾向</li>
    </ul>
  </section>

  <section class="lp-section">
    <div class="section-num">SECTION 05</div>
    <h2>まとめ — 自分の状況に合う選択肢を専門家と相談する</h2>
    <p>
      うつ病・メンタル不調の退職代行は、<strong>公的保護の理解 + 退職代行サービスの活用検討 + 退職後の手続き準備</strong> の3点を整理した上で、自分の状況に合う選択肢を専門家と相談するのが現実的アプローチとして運用されています。本人の意思尊重が前提とされており、無料相談・公的窓口の活用も選択肢とされます。
    </p>
  </section>

  <BannerAB pageSlug={slug} position="final" />

  <section class="faq-section">
    <h2>よくある質問</h2>
    {faq.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </section>

  <section class="lp-section">
    <h2>参考情報・公開出典</h2>
    <ul class="source-list">
      <li>労働基準法</li>
      <li>民法 (第627条 雇用契約解約)</li>
      <li>男女雇用機会均等法・育児介護休業法</li>
      <li>労働組合法</li>
      <li>厚生労働省「労働相談・窓口」</li>
      <li>国民生活センター「労働トラブル相談事例」</li>
    </ul>
  </section>

</RichLayout>
