---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行で「訴えられる」リスク｜法的根拠と対処法（2026年版・PR）';
const description = '退職代行を使うと会社から訴えられるか不安な方へ。労働基準法第16条・民法第627条の法的根拠と、損害賠償請求が認められないケースを整理した情報提供記事です（PR・アフィリエイト広告を含みます）。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行', url: '/' },
  { name: '訴えられるリスク' },
];

const faq = [
  { q: '退職代行を使うと会社から訴えられますか？', a: '労働基準法第16条で「労働者の意思に反する違約金・損害賠償の予約」は禁止されており、退職を理由とした損害賠償請求は原則認められないとされています。脅迫的な内容を受けた場合は弁護士または労働基準監督署への相談が推奨されます。' },
  { q: '退職代行を使ったら会社から本当に損害賠償を請求されたケースはありますか？', a: '一部の特殊ケース（重要なプロジェクトを途中放棄・引き継ぎ完全拒否等）では訴訟になるケースがゼロではないとされています。ただし、通常の退職で勝訴例は極めて少ないとされています。' },
  { q: '訴えられた場合の対処法は？', a: '弁護士または法テラスへの相談、内容証明郵便の受領記録、就業規則・雇用契約書の確認、業者経由での対応継続が推奨されます。脅迫的な内容は記録（録音・スクリーンショット）することが推奨されます。' },
];
---

<RichLayout title={title} description={description} publishedDate="2026-05-15" modifiedDate="2026-05-18" breadcrumb={breadcrumb} faq={faq}>
  <section class="fv" aria-labelledby="fv-h1">
    <div class="container">
      <span class="fv-pill">退職代行 / 訴えられるリスク</span>
      <h1 id="fv-h1"><span class="accent">退職代行で「訴えられる」リスク</span><br />法的根拠と対処法</h1>
      <p class="lede">退職代行を使ったことを理由とした損害賠償請求は、労働基準法第16条により原則認められないとされています。ただし、脅迫的な内容を受けた場合や特殊ケースでは弁護士相談が推奨されます。本記事では法的根拠と対処法を整理します。</p>
      <ul class="fv-bullets">
        <li>退職代行で訴えられない法的根拠 (労基法16条・民法627条)</li>
        <li>訴訟リスクが上がる特殊ケース</li>
        <li>「訴える」と脅されたときの対処法 (4 step)</li>
        <li>弁護士法人型退職代行の選択肢</li>
      </ul>
      <PRBadge pageSlug="uttaerareru" />
      <div class="fv-meta">
        <span><b>公開日</b> 2026-05-15</span><span><b>最終更新</b> 2026-05-18</span>
        <span><b>編集</b> NY-squared 編集部</span><span><b>所要</b> 約 6 分</span>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-intro">
    <div class="container">
      <p class="section-num">SECTION / 00</p>
      <h2>はじめに (PR表示・前提)</h2>
      <p><strong>📢 PR表示</strong>: 本ページはアフィリエイト広告（PR）を含みます。本サイトは法律事務所・退職代行業者公式サイトではなく、公開情報を整理した一般論ベースの情報提供サイトです。個別案件の判断は<strong>必ず弁護士・各業者に直接ご相談ください</strong>。</p>
      <p style="font-size:13px;color:var(--c-text-sub,#4a5568);">最終確認日: 2026-05-15 / 公開情報の整理であり、特定サービスを推奨するものではありません。<br />運営者: <a href="/operator-info/">NY-squared (個人事業)</a> / <a href="/editorial-policy/">編集ポリシー</a> / <a href="/privacy-policy/">プライバシーポリシー</a></p>
      <p><strong>結論</strong>: 退職代行を使ったことを理由とした損害賠償請求は、労働基準法第16条により原則認められないとされています。</p>
      <p>ただし、脅迫的な内容を受けた場合や特殊ケースでは弁護士相談が推奨されます。本記事では法的根拠と対処法を整理します。</p>
      <BannerAB pageSlug="uttaerareru" position="hero" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-1">
    <div class="container">
      <p class="section-num">SECTION / 01</p>
      <h2>退職代行で訴えられない法的根拠</h2>
      <h3>1-1. 労働基準法第16条（賠償予定の禁止）</h3>
      <p><a href="https://elaws.e-gov.go.jp/document?lawid=322AC0000000049" target="_blank" rel="noopener">労働基準法第16条 e-Gov</a>では「使用者は、労働契約の不履行について違約金を定め、又は損害賠償額を予定する契約をしてはならない」と定められています。退職を理由とした損害賠償請求は原則認められないとされています。</p>
      <h3>1-2. 民法第627条（退職の自由）</h3>
      <p><a href="https://elaws.e-gov.go.jp/document?lawid=129AC0000000089" target="_blank" rel="noopener">民法第627条 e-Gov</a>では「雇用は、解約の申入れの日から2週間を経過することによって終了する」と定められており、無期雇用契約の場合、原則として2週間前の通告で退職可能とされています。</p>
      <h3>1-3. 業務命令違反 vs 退職の意思表示</h3>
      <p>会社が「業務命令違反」を理由に損害賠償を主張するケースがあるとされていますが、退職自体は法的に認められた権利のため、業務命令違反として扱うことは難しいとされています。</p>
    </div>
  </section>

  <section class="lp-section" id="sec-2">
    <div class="container">
      <p class="section-num">SECTION / 02</p>
      <h2>訴訟リスクが上がる特殊ケース</h2>
      <h3>⚠️ ケース①: 重要プロジェクトの途中放棄</h3>
      <p>会社に重大な損害を発生させた場合（例: 進行中の重要プロジェクトを完全放棄）、損害賠償請求の対象となる可能性がゼロではないとされています。ただし「業務引き継ぎを誠実に行う」姿勢を示すことで多くは回避できるとされています。</p>
      <h3>⚠️ ケース②: 機密情報の持ち出し</h3>
      <p>退職時に顧客リスト・営業秘密等を持ち出した場合は不正競争防止法違反となり、別途訴訟リスクがあるとされています。退職時は業務関連データを社内に残すことが推奨されます。</p>
      <h3>⚠️ ケース③: 公務員・国家公務員</h3>
      <p>公務員は民間と異なり国家公務員法・地方公務員法の適用を受け、退職代行の利用前に専門弁護士への相談が推奨されます。</p>
      <BannerAB pageSlug="uttaerareru" position="middle" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-3">
    <div class="container">
      <p class="section-num">SECTION / 03</p>
      <h2>「訴える」と脅されたときの対処法</h2>
      <div class="counter-box">
        <h3>📌 対処法 4ステップ</h3>
        <div class="row"><b>Step 1: 内容を記録</b><span>電話の場合は録音、LINE/メールはスクリーンショットを取得。日時・内容を時系列で整理します。</span></div>
        <div class="row"><b>Step 2: 業者に共有</b><span>退職代行業者に脅迫内容を共有し、業者経由で「直接連絡は不要」と再度意思表示してもらいます。</span></div>
        <div class="row"><b>Step 3: 弁護士・労働基準監督署へ相談</b><span>脅迫が継続する場合は弁護士または労働基準監督署へ相談。法テラスでは無料相談制度があるとされています。</span></div>
        <div class="row"><b>Step 4: 内容証明郵便を受け取った場合</b><span>内容証明郵便を受領した場合は、まず受領記録を保存し、弁護士に内容を確認してもらうことが推奨されます。返答期限がある場合は期限内に弁護士経由で対応します。</span></div>
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-4">
    <div class="container">
      <p class="section-num">SECTION / 04</p>
      <h2>弁護士法人型退職代行の選択肢</h2>
      <p>訴訟リスクを最小化したい場合や、すでに会社から脅迫を受けている場合は、弁護士法人が運営する退職代行サービスを選ぶ選択肢があるとされています。料金は民間型より高めですが、法的対応・損害賠償交渉も可能とされています。</p>
      <BannerAB pageSlug="uttaerareru" position="footer" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-faq">
    <div class="container">
      <p class="section-num">SECTION / 05</p>
      <h2>よくある質問（FAQ）</h2>
      <div class="faq">
        {faq.map((item) => (
          <details><summary>{item.q}</summary><div><p set:html={item.a} /></div></details>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-section" id="sec-summary">
    <div class="container">
      <p class="section-num">SECTION / 06</p>
      <h2>まとめ</h2>
      <ul>
        <li>退職代行で訴えられるリスクは原則低い（労働基準法第16条）</li>
        <li>重要プロジェクト放棄・機密情報持ち出し等の特殊ケースには注意</li>
        <li>脅迫を受けた場合は記録 → 業者共有 → 弁護士相談</li>
        <li>訴訟リスクが高い場合は弁護士法人型を選択肢に</li>
      </ul>
      <p><strong>関連記事・参考リンク</strong></p>
      <ul>
        <li><a href="/kaisha-renraku/">退職代行を使っても会社から連絡が来たらどうする？正しい対処法</a></li>
        <li><a href="/atobarai/">退職代行の後払い OK｜手元資金ゼロでも即日退職できる選び方</a></li>
        <li><a href="/part-time/">パートも退職代行を使える｜法的根拠と注意点</a></li>
        <li><a href="/black-kigyou/">ブラック企業からの退職に退職代行が選ばれる理由</a></li>
        <li><a href="/shippai/">退職代行 失敗例と対策</a></li>
      </ul>
      <p style="font-size:13px;color:var(--c-text-mute,#6b7280);">※ 本記事は公開情報を整理した一般論であり、個別案件の判断には法的助言が必要です。退職代行サービスは民法第627条に基づく代理通告であり、法的効果・退職可否を保証するものではありません。具体的な判断は弁護士・各業者に直接ご相談ください。</p>
      <PRBadge pageSlug="uttaerareru" label="退職代行サービスの公式サイトで無料相談する（PR）" />
    </div>
  </section>

  <section class="lp-section alt" id="sec-policy">
    <div class="container">
      <p class="section-num">SECTION / 07</p>
      <h2>編集ポリシー (情報源・更新日・E-E-A-T)</h2>
      <ul>
        <li><strong>情報源</strong>: 政府公式 e-Gov 法令検索 (民法・労働基準法・不正競争防止法) ・厚生労働省公式サイト ・各退職代行業者公式サイト ・退職代行関連の公開統計情報</li>
        <li><strong>編集方針</strong>: 一次情報優先 (法令は e-Gov 直接リンク・運営形態は公式サイト確認) ・断定表現を避け推定値・公開情報の整理として記述</li>
        <li><strong>更新頻度</strong>: 月次レビュー (法令改正・サービス内容変更時は随時更新)</li>
        <li><strong>運営者</strong>: NY-squared (個人事業) <a href="/operator-info/">運営情報ページ</a> 参照</li>
        <li><strong>E-E-A-T 4 原則</strong>: Experience (退職代行関連の公開情報整理) ・Expertise (法令引用 + 業界公開統計) ・Authoritativeness (政府公式 + 業者公式の一次情報のみ) ・Trustworthiness (PR 表記 + 推定値明示 + 法的助言ではない注記)</li>
      </ul>

      <h2>公的相談窓口 / 出典・参考情報</h2>
      <ul>
        <li><a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/koyou_roudou/roudoukijun/zenkoku/index.html" target="_blank" rel="noopener">厚生労働省 全国労働基準監督署一覧</a> — 労働基準法違反・脅迫的な対応の通報窓口</li>
        <li><a href="https://www.houterasu.or.jp/" target="_blank" rel="noopener">法テラス（日本司法支援センター）</a> — 無料法律相談・弁護士費用立て替え制度</li>
        <li><a href="https://www.kokusen.go.jp/" target="_blank" rel="noopener">国民生活センター</a> — 退職代行サービスのトラブル相談</li>
        <li><a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/koyou_roudou/roudouseisaku/sougoutekina_taisaku/index.html" target="_blank" rel="noopener">厚生労働省 労働相談窓口</a> — パワハラ・労働条件のトラブル相談</li>
        <li><a href="https://elaws.e-gov.go.jp/document?lawid=322AC0000000049" target="_blank" rel="noopener">労働基準法第16条 (賠償予定の禁止・e-Gov)</a></li>
        <li><a href="https://elaws.e-gov.go.jp/document?lawid=129AC0000000089" target="_blank" rel="noopener">民法第627条 (退職の権利・e-Gov)</a></li>
      </ul>
      <p style="font-size:12px;color:var(--c-text-mute,#6b7280);margin-top:16px;">
        ※本記事は2026年5月時点の公開情報をもとに作成。最新の法令・サービス内容は各公式サイトでご確認ください。訴訟リスク・対処法は一般的傾向を整理したもので、個別案件の判断は弁護士・各業者へご相談ください。本ページはアフィリエイト広告（PR）を含みます。
      </p>
    </div>
  </section>
</RichLayout>
