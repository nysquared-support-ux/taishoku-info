---
import RichLayout from '../../layouts/RichLayout.astro';
import PRBadge from '../../components/PRBadge.astro';
import BannerAB from '../../components/BannerAB.astro';

const title = '退職代行で有給消化はできる？残日数を全消化して辞める方法を徹底解説（2026年版・PR）';
const description = '退職代行を使って有給休暇を全日数消化したい方へ。労働基準法第39条の権利・業者形態別の交渉力比較・STEP 5段階の利用フロー・確実消化のための業者選び3条件を公開情報ベースで整理した情報提供記事です（PR・アフィリエイト広告を含みます）。個別判断は弁護士・各業者へご相談ください。';

const breadcrumb = [
  { name: 'ホーム', url: '/' },
  { name: '退職代行', url: '/' },
  { name: '有給消化' },
];

const faq = [
  { q: '退職代行を使っても、本当に有給休暇を消化できるのでしょうか？', a: 'はい、有給休暇の取得は労働基準法第39条で定められた労働者の正当な権利です。退職代行サービスは、本人に代わってこの権利を行使したいという意思を会社に伝える役割を担います。会社側は原則としてこれを拒否できないと解されています。' },
  { q: '有給休暇の残り日数がわからない場合、どうすればよいですか？', a: 'まずは給与明細や就業規則を確認することが基本です。それが難しい場合、退職代行業者に相談することで、業者から会社側へ残日数の確認を依頼してもらえるケースが一般的です。正確な日数を把握した上で、退職日を調整することが可能になります。' },
  { q: '会社から「引継ぎが終わるまで有給消化は認めない」と言われませんか？', a: '業務の引継ぎは労働者の信義則上の義務とされますが、それを理由に有給休暇の取得を一方的に拒否することは、原則として認められないとされています。万が一、会社が交渉に応じない場合は、交渉権を持つ弁護士や労働組合が運営する代行業者への相談が有効です。' },
  { q: '有給消化中に、会社から直接連絡が来たら対応すべきですか？', a: '退職代行サービスを利用した場合、連絡はすべて代行業者を通すよう会社側に伝えてもらうのが一般的です。そのため、基本的には直接対応する必要はないとされます。ただし、緊急の業務確認など、やむを得ない場合も想定されるため、その際の対応方法も事前に業者と相談しておくと安心です。' },
  { q: '有給を確実に全日数消化するために、業者選びで重要な点は何ですか？', a: '会社との間で有給消化に関する交渉が必要になった場合、非弁護士の民間業者は対応できません。弁護士法第72条（非弁行為の禁止）の観点から、弁護士法人または労働組合が運営する、交渉権を持つ代行業者を選ぶことが、権利を確実に行使するための重要なポイントとなります。' },
];
---

